admit_file() {
  node "$RELEASE_MANIFEST" admit-file --source "$1" --output "$2" \
    --expected-sha256 "$3" --maximum-bytes "$4" >/dev/null
}

admit_signature() {
  node "$RELEASE_MANIFEST" admit-signature --source "$1" --output "$2" --maximum-bytes 16777216 >/dev/null
}

artifact_prepare() {
  local input_root="$1" sha="$2" tree="$3" run_id="$4" manifest_sha="$5"
  local target="$6" config_sha="$7" workflow_attempt="$8"
  local temp transaction profile artifact filename expected field ref
  validate_sha "$sha"
  validate_sha "$tree"
  validate_run_id "$run_id"
  [ "$input_root" = "$CANDIDATE_PARENT/$run_id/candidate" ] || die 'unexpected candidate artifact root'
  validate_sha256 "$manifest_sha"
  validate_target "$target"
  if [ "$target" = production ]; then
    require_release_lane oci-production
  else
    require_release_lane legacy-shadow
  fi
  validate_digest "$config_sha"
  [[ "$workflow_attempt" =~ ^[1-9][0-9]{0,9}$ ]] || die 'invalid workflow run attempt'
  require_current_state
  if [ "$target" = production ]; then
    [ "$(jq -er '.laneState' "$CURRENT_STATE")" = oci-production ] || die 'live high-water is not OCI production'
  fi
  require_secure_root_file "$REGISTRY_ENV" 600
  if [ "$target" = production ]; then require_secure_root_file "$PRODUCTION_ENV" 600; fi
  transaction="$(artifact_transaction "$run_id")"
  if [ -e "$transaction" ]; then
    require_delivery_invocation "$run_id" "$target" prepare
    if [ "$target" = production ]; then
      if transaction_finish_committed "$run_id"; then return 0; fi
      transaction_resume_prepared "$run_id" "$sha" "$tree" "$manifest_sha" "$config_sha" "$workflow_attempt"
    else
      transaction_resume_shadow "$run_id" "$sha" "$tree" "$manifest_sha" "$config_sha" "$workflow_attempt"
    fi
    return 0
  fi
  if [ -e "$ACTIVE_TRANSACTION" ]; then
    if [ "$target" = production ]; then die 'another production transaction is active'; fi
    die 'production transaction is active during shadow verification'
  fi

  temp="$(mktemp -d --tmpdir="$TRANSACTION_ROOT" '.prepare.XXXXXX')"
  # Capture the path now: EXIT can run after function-local variables unwind.
  trap "unset DOCKER_CONFIG HB_REGISTRY_TOKEN HB_REGISTRY_USERNAME; rm -rf -- $(printf '%q' "$temp")" EXIT
  install -d -o root -g root -m 0700 "$temp/candidate" "$temp/candidate/evidence" "$temp/prior" "$temp/docker"
  admit_file "$input_root/release-manifest.json" "$temp/candidate/candidate-manifest.json" "sha256:$manifest_sha" 1048576
  local manifest="$temp/candidate/candidate-manifest.json"
  # Bundles are untrusted cryptographic envelopes; descriptor-safe copy, then
  # authenticate the exact root-owned bytes before using any manifest selector.
  for filename in release-manifest.signature.bundle.json qualification-receipt.signature.bundle.json; do
    admit_signature "$input_root/$filename" "$temp/candidate/$filename"
  done
  cosign verify-blob --bundle "$temp/candidate/release-manifest.signature.bundle.json" \
    --certificate-oidc-issuer https://token.actions.githubusercontent.com \
    --certificate-identity https://github.com/AlterMundi/harmonic-beacon-webapp/.github/workflows/oci-candidate.yml@refs/heads/main \
    "$manifest" >/dev/null || die 'unauthenticated final manifest'
  admit_delivery_authorization "$input_root" "$temp/delivery"
  if [ "$target" = production ]; then
    admit_transition_evidence "$input_root" "$temp/transition"
    require_oci_transition_evidence "$manifest" "$temp/transition"
  fi
  node "$RELEASE_MANIFEST" validate-delivery --authorization "$temp/delivery/delivery-authorization.json" \
    --manifest "$manifest" --source-sha "$sha" --source-tree "$tree" --manifest-sha256 "$manifest_sha" \
    --candidate-run-id "$run_id" --candidate-run-attempt "$workflow_attempt" \
    --delivery-run-id "$DELIVERY_RUN_ID" --delivery-run-attempt "$DELIVERY_RUN_ATTEMPT" \
    --target "$target" --config-sha256 "$config_sha" --output "$temp/delivery.json"
  # Parse only the authenticated admitted manifest; remaining paths are fixed.
  admit_file "$input_root/qualification-receipt.json" "$temp/candidate/qualification-receipt.json" "$(jq -er '.qualification.receiptSha256' "$manifest")" 1048576
  admit_file "$input_root/docker-compose.yml" "$temp/candidate/docker-compose.yml" "$(jq -er '.deploymentInputs.composeSha256' "$manifest")" 4194304
  admit_file "$input_root/deploy/oci-images.compose.yml" "$temp/candidate/oci-images.compose.yml" "$(jq -er '.deploymentInputs.overlaySha256' "$manifest")" 4194304
  # Compose is active configuration: require the installed reviewed bytes too.
  cmp --silent "$TRUSTED_COMPOSE" "$temp/candidate/docker-compose.yml" || die 'unreviewed Compose input'
  cmp --silent "$TRUSTED_OVERLAY" "$temp/candidate/oci-images.compose.yml" || die 'unreviewed OCI overlay'
  for profile in production live-staging; do
    admit_file "$input_root/deploy/runtime-public-config/$profile.json" "$temp/candidate/$profile.json" "$(jq -er --arg profile "$profile" '.configProfiles[$profile].sha256' "$manifest")" 1048576
  done
  profile=production
  [ "$target" = production ] || profile=live-staging
  install -o root -g root -m 0600 "$temp/candidate/$profile.json" "$temp/candidate/target-public-config.json"
  for artifact in app tapestry playlist-bot analytics; do
    install -d -o root -g root -m 0700 "$temp/candidate/evidence/oci-evidence-$artifact"
    while read -r filename field; do
      expected="$(jq -er --arg id "$artifact" ".artifacts[] | select(.artifactId==\$id) | $field" "$manifest")"
      admit_file "$input_root/evidence/oci-evidence-$artifact/$filename" "$temp/candidate/evidence/oci-evidence-$artifact/$filename" "$expected" 16777216
    done <<'EOF'
evidence.json .evidenceRecordDigest
sbom.bundle.json .sbom.digest
sbom.signature.bundle.json .sbom.signatureBundleDigest
provenance.bundle.json .provenance.digest
provenance.signature.bundle.json .provenance.signatureBundleDigest
signature.bundle.json .signature.bundleDigest
EOF
  done
  install -o root -g root -m 0600 "$CURRENT_STATE" "$temp/prior-state.json"
  state_unpack "$temp/prior-state.json" "$temp/prior"
  verify_prior_state_inputs "$temp/prior"
  if [ "$target" = production ]; then
    require_rollback_safe_public_config \
      "$temp/candidate/target-public-config.json" "$temp/prior/target-public-config.json"
  fi

  require_unchanged_runtime_inputs "$temp"
  # Root never inspects mutable repository Git state. Until a protected,
  # authorization-bound per-service plan is admitted, expand conservatively.
  "$CHANGE_IMPACT" --file .github/workflows/oci-promote.yml --json > "$temp/impact-plan.json"
  chown root:root "$temp/impact-plan.json"
  chmod 0600 "$temp/impact-plan.json"
  "$IMPACT_RECOVERY" validate-impact --input "$temp/impact-plan.json"

  export DOCKER_CONFIG="$temp/docker"
  local verifier_args=(
    --manifest "$temp/candidate/candidate-manifest.json" --evidence "$temp/candidate/evidence"
    --manifest-sha256 "$manifest_sha" --source-sha "$sha" --source-tree "$tree"
    --workflow-run-id "$run_id" --workflow-run-attempt "$workflow_attempt"
    --target "$target" --config-sha256 "$config_sha"
    --current-manifest "$temp/prior/prior-manifest.json"
    --compose "$temp/candidate/docker-compose.yml" --overlay "$temp/candidate/oci-images.compose.yml"
    --config-profile "$temp/candidate/target-public-config.json" --output "$temp/verified.json"
  )
  if [ "$target" = production ]; then verifier_args+=(--runtime-env "$PRODUCTION_ENV"); fi
  "$ARTIFACT_VERIFY" "${verifier_args[@]}"
  jq -e . "$temp/verified.json" >/dev/null || die 'artifact verifier emitted invalid receipt'
  jq --slurpfile delivery "$temp/delivery.json" --arg target "$target" --arg phase prepared \
    --arg impactPlanSha256 "$(sha256sum "$temp/impact-plan.json" | cut -d' ' -f1)" \
    '. + $delivery[0] + {target:$target,phase:$phase,impactPlanSha256:$impactPlanSha256,replacedServices:[],rolledBackServices:[]}' \
    "$temp/verified.json" > "$temp/receipt.json"
  node "$RELEASE_MANIFEST" bind-publications --state "$CURRENT_STATE" --receipt "$temp/receipt.json" --output "$temp/receipt.new"
  mv -- "$temp/receipt.new" "$temp/receipt.json"
  chmod 0600 "$temp/receipt.json"
  sync -f "$temp/receipt.json"
  sync -f "$temp"

  # Signature and registry evidence verification can take time. Recheck expiry
  # on the persisted receipt immediately before the first registry effect.
  node "$RELEASE_MANIFEST" check-delivery --receipt "$temp/receipt.json" \
    --delivery-run-id "$DELIVERY_RUN_ID" --delivery-run-attempt "$DELIVERY_RUN_ATTEMPT" \
    --target "$target" --verb prepare
  if [ "$target" = production ]; then
    require_oci_transition_evidence "$manifest" "$temp/transition"
  fi
  # Burn this exact protected run/attempt before effects, including shadow.
  # A failed pre-publication prepare requires a fresh hosted authorization.
  if [ -e "$ARTIFACT_STATE/delivery-used" ] || [ -L "$ARTIFACT_STATE/delivery-used" ]; then
    require_secure_root_ancestors "$ARTIFACT_STATE/delivery-used/.probe"
  fi
  install -d -o root -g root -m 0700 "$ARTIFACT_STATE/delivery-used"
  mkdir -m 0700 -- "$ARTIFACT_STATE/delivery-used/$DELIVERY_RUN_ID-$DELIVERY_RUN_ATTEMPT" ||
    die 'delivery authorization already consumed'
  sync -f "$ARTIFACT_STATE/delivery-used"
  # The credential file is root-only and is never exposed to candidate code.
  # shellcheck disable=SC1090
  source "$REGISTRY_ENV"
  [ -n "${HB_REGISTRY_USERNAME:-}" ] && [ -n "${HB_REGISTRY_TOKEN:-}" ] || die 'registry credentials are incomplete'
  printf '%s' "$HB_REGISTRY_TOKEN" | docker login ghcr.io --username "$HB_REGISTRY_USERNAME" --password-stdin >/dev/null
  while IFS= read -r artifact; do
    ref="$(manifest_ref "$temp/candidate/candidate-manifest.json" artifacts "$artifact")"
    docker pull "$ref" >/dev/null
  done < <(jq -r '.deployment.artifactsToPull[]' "$temp/impact-plan.json")
  build_next_service_releases "$temp" "$sha" "$run_id"
  unset HB_REGISTRY_TOKEN HB_REGISTRY_USERNAME
  rm -rf -- "$temp/docker" "$temp/prior-state.json" "$temp/deployed-state.json" "$temp/verified.json"
  chmod 0700 "$temp"
  sync -f "$temp/receipt.json"
  # Reuse full live verification before this disposable transaction becomes
  # visible. Shadow evidence is meaningful only against the exact live base.
  (
    artifact_transaction() { printf '%s\n' "$temp"; }
    verify_release_runtime_state "$run_id" prior
  )
  mv -- "$temp" "$transaction"
  sync -f "$TRANSACTION_ROOT"
  test_failpoint transaction-directory-fsync
  if [ "$target" = production ]; then atomic_write_active_transaction "$run_id"; fi
  trap - EXIT
}

artifact_impact() {
  local run_id="$1" target="$2"
  if [ "$target" = production ] && transaction_finish_committed "$run_id"; then
    jq -c '{schemaVersion,risk,domains,matrices,requiredChecks,deployment,details}' \
      "$(artifact_transaction "$run_id")/impact-plan.json"
    return 0
  fi
  transaction_require "$run_id" "$target" prepared migration-attempted migration-skipped migrated replaced
  jq -c '{schemaVersion,risk,domains,matrices,requiredChecks,deployment,details}'     "$(artifact_transaction "$run_id")/impact-plan.json"
}

artifact_preflight() {
  local run_id="$1" target="$2"
  if [ "$target" = production ] && transaction_finish_committed "$run_id"; then return 0; fi
  if [ "$target" = shadow ]; then
    transaction_require "$run_id" "$target" prepared shadowed
  else
    transaction_require "$run_id" "$target" prepared migration-attempted migration-skipped migrated replaced
  fi
  if [ "$target" = production ]; then
    [ -r "$PRODUCTION_ENV" ] || die 'production environment is not readable by root'
    [ -r "$COMMERCE_ENV" ] || die 'commerce environment is not readable by root'
    require_secure_root_file "$COMMERCE_ENV" 600
    if [ -e "$ACCOUNT_ENV" ]; then
      require_secure_root_file "$ACCOUNT_ENV" 600
      container_has_env_name beacon-app BEACON_ACCOUNT_ENABLED &&
        [ "$(docker inspect beacon-app --format '{{range .Config.Env}}{{println .}}{{end}}' |
          sed -n 's/^BEACON_ACCOUNT_ENABLED=//p' | tail -n 1)" = true ] ||
        die 'Account bundle exists before the supervised Account activation'
    fi
    if grep -Fxq 'E2E_DASHBOARD_ENABLED=1' "$PRODUCTION_ENV"; then
      die 'production E2E dashboard must be disabled before deploy'
    fi
    verify_runtime_profile "$run_id"
    require_exact_private_network
    artifact_compose "$run_id" config --quiet
    verify_container_image beacon-postgres "$(artifact_ref "$run_id" externalImages postgres)"
    verify_container_image beacon-livekit "$(artifact_ref "$run_id" externalImages livekit)"
    while IFS= read -r service; do
      verify_pulled_image "$(jq -er --arg service "$service" '.[$service].imageRef' \
        "$(artifact_transaction "$run_id")/next-service-releases.json")"
    done < <(jq -r '.deployment.servicesToReplace[]' "$(artifact_transaction "$run_id")/impact-plan.json")
  fi
}

database_backup_restore() {
  local run_id="$1" transaction dump partial container_dump restore_db proof digest restore_result
  transaction="$(artifact_transaction "$run_id")"
  proof="$transaction/backup-restore.json"
  if [ -f "$proof" ]; then
    jq -e --arg run "$run_id" '.schemaVersion=="harmonic-beacon.backup-restore.v1" and .runId==$run and .result=="success" and .fresh==true and .isolatedRestore==true and .candidateMigrationVerified==true' "$proof" >/dev/null ||
      die 'existing backup/restore proof is invalid'
    return 0
  fi
  mountpoint -q /mnt/beacon-data || die 'database backup filesystem is not mounted'
  install -d -o root -g root -m 0700 "$DATABASE_BACKUP_ROOT"
  dump="$DATABASE_BACKUP_ROOT/release-${run_id}.dump"
  partial="${dump}.partial"
  container_dump="/tmp/hb-release-${run_id}.dump"
  restore_db="hb_restore_${run_id}"
  restore_result="$transaction/restore-verification.json"
  if [ ! -f "$dump" ]; then
    rm -f -- "$partial"
    docker exec beacon-postgres sh -eu -c 'pg_dump --format=custom --no-owner --no-acl --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' > "$partial"
    [ -s "$partial" ] || die 'database backup is empty'
    chown root:root "$partial"
    chmod 0600 "$partial"
    mv -f -- "$partial" "$dump"
    sync -f "$dump"
  fi
  docker cp "$dump" "beacon-postgres:$container_dump" >/dev/null
  docker exec beacon-postgres sh -eu -c 'dropdb --if-exists --username="$POSTGRES_USER" "$1"; createdb --username="$POSTGRES_USER" "$1"; pg_restore --exit-on-error --no-owner --no-acl --username="$POSTGRES_USER" --dbname="$1" "$2"' sh "$restore_db" "$container_dump"
  if ! artifact_compose "$run_id" run --rm --no-deps --no-build --pull never \
    -e "HB_RESTORE_DATABASE_NAME=$restore_db" migrate npx tsx scripts/release-restore-verify.ts > "$restore_result"; then
    docker exec beacon-postgres sh -eu -c 'dropdb --if-exists --username="$POSTGRES_USER" "$1"; rm -f -- "$2"' sh "$restore_db" "$container_dump" || true
    die 'candidate migration failed against isolated restored backup'
  fi
  jq -e '.candidateMigrationVerified==true and (keys|sort)==(["candidateMigrationVerified"]|sort)' \
    "$restore_result" >/dev/null || die 'isolated restore verifier emitted an invalid result'
  docker exec beacon-postgres sh -eu -c 'dropdb --username="$POSTGRES_USER" "$1"; rm -f -- "$2"' sh "$restore_db" "$container_dump"
  digest="$(sha256sum "$dump" | cut -d' ' -f1)"
  jq -n --arg runId "$run_id" --arg dumpSha256 "$digest" --arg createdAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schemaVersion:"harmonic-beacon.backup-restore.v1",runId:$runId,result:"success",fresh:true,isolatedRestore:true,candidateMigrationVerified:true,dumpSha256:$dumpSha256,createdAt:$createdAt}' > "$proof"
  chown root:root "$proof"
  chmod 0600 "$proof"
  sync -f "$proof"
}

artifact_migrate() {
  local run_id="$1" transaction phase migration_policy pending
  if transaction_finish_committed "$run_id"; then return 0; fi
  transaction_require "$run_id" production prepared migration-attempted migration-skipped migrated
  transaction="$(artifact_transaction "$run_id")"
  phase="$(transaction_phase "$run_id")"
  verify_release_runtime_state "$run_id" prior
  if [ "$phase" = migration-skipped ] || [ "$phase" = migrated ]; then return 0; fi
  migration_policy="$(jq -er '.deployment.migration' "$transaction/impact-plan.json")"
  if [ "$phase" = prepared ]; then
    if [ "$migration_policy" = never ]; then
      jq -n '{schemaVersion:"harmonic-beacon.migration-state.v1",databaseStateVerified:true,applied:[],pending:[],failed:[],unexpected:[],unsafe:[]}' > "$transaction/migration-state.json"
      transaction_set_phase "$run_id" migration-skipped
      return 0
    fi
    artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
      npx tsx scripts/release-migration-state.ts > "$transaction/migration-state.json"
    chown root:root "$transaction/migration-state.json"
    chmod 0600 "$transaction/migration-state.json"
    jq -e '.schemaVersion=="harmonic-beacon.migration-state.v1" and .databaseStateVerified==true and (.failed|length)==0 and (.unexpected|length)==0 and (.unsafe|length)==0' \
      "$transaction/migration-state.json" >/dev/null || die 'database migration state is not verified'
    pending="$(jq '.pending|length' "$transaction/migration-state.json")"
    if [ "$pending" -eq 0 ]; then
      transaction_set_phase "$run_id" migration-skipped
      return 0
    fi
    verify_migration_recovery_targets "$run_id"
    database_backup_restore "$run_id"
    "$IMPACT_RECOVERY" plan-database --impact "$transaction/impact-plan.json" \
      --state "$transaction/migration-state.json" --backup-proof "$transaction/backup-restore.json" \
      --run-id "$run_id" > "$transaction/database-action.json"
    transaction_set_phase "$run_id" migration-attempted
  fi
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  artifact_compose "$run_id" stop app commerce-reconciler
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate npx prisma migrate deploy
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/stage-grant-forward-drain.ts
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate npx prisma migrate status
  transaction_set_phase "$run_id" migrated
}

artifact_replace() {
  local run_id="$1" transaction phase service temporary container expected prior_id current_id attempt_service
  if transaction_finish_committed "$run_id"; then return 0; fi
  transaction_require "$run_id" production migrated migration-skipped replaced
  transaction="$(artifact_transaction "$run_id")"
  phase="$(transaction_phase "$run_id")"
  [ "$phase" != replaced ] || return 0
  verify_runtime_profile "$run_id"
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  while IFS= read -r service; do
    jq -e --arg service "$service" '.replacedServices | index($service)' "$transaction/receipt.json" >/dev/null && continue
    [ "$service" != analytics ] || die 'analytics uses its dedicated deployment lane'
    container="$(container_for_service "$service")"
    expected="$(jq -er --arg service "$service" '.[$service].imageRef' "$transaction/next-service-releases.json")"
    attempt_service="$(jq -r '.replacementAttempt.service // empty' "$transaction/receipt.json")"
    if [ -n "$attempt_service" ] && [ "$attempt_service" != "$service" ]; then
      die 'replacement checkpoint names a different service'
    fi
    if [ "$attempt_service" = "$service" ]; then
      prior_id="$(jq -er '.replacementAttempt.priorContainerId' "$transaction/receipt.json")"
      current_id="$(docker inspect "$container" --format '{{.Id}}' 2>/dev/null || true)"
    else
      prior_id="$(docker inspect "$container" --format '{{.Id}}')"
      temporary="$transaction/receipt.json.new"
      jq --arg service "$service" --arg priorContainerId "$prior_id" \
        '.replacementAttempt={service:$service,priorContainerId:$priorContainerId}' "$transaction/receipt.json" > "$temporary"
      chown root:root "$temporary"; chmod 0600 "$temporary"; sync -f "$temporary"
      mv -f -- "$temporary" "$transaction/receipt.json"
      current_id="$prior_id"
    fi
    if [ -z "$current_id" ] || [ "$current_id" = "$prior_id" ] || \
      ! verify_container_image "$container" "$expected" >/dev/null 2>&1; then
      artifact_compose_service_from "$run_id" candidate "$service" up -d --no-deps --force-recreate --no-build --pull never
      verify_container_image "$container" "$expected"
    fi
    temporary="$transaction/receipt.json.new"
    jq --arg service "$service" '.replacedServices += [$service] | del(.replacementAttempt)' "$transaction/receipt.json" > "$temporary"
    chown root:root "$temporary"
    chmod 0600 "$temporary"
    sync -f "$temporary"
    mv -f -- "$temporary" "$transaction/receipt.json"
  done < <(jq -r '.deployment.servicesToReplace[]' "$transaction/impact-plan.json")
  transaction_set_phase "$run_id" replaced
}

verify_container_image() {
  local container="$1" expected="$2" configured actual expected_id
  validate_image_ref "$expected"
  [ "$(docker inspect "$container" --format '{{.State.Running}}')" = true ] || die "$container is not running"
  configured="$(docker inspect "$container" --format '{{.Config.Image}}')"
  [ "$configured" = "$expected" ] || die "$container configured image does not match the manifest"
  actual="$(docker inspect "$container" --format '{{.Image}}')"
  expected_id="$(docker image inspect "$expected" --format '{{.Id}}')"
  [ -n "$actual" ] && [ "$actual" = "$expected_id" ] || die "$container actual image ID does not match the exact digest"
}

verify_pulled_image() {
  local expected="$1"
  validate_image_ref "$expected"
  docker image inspect "$expected" --format '{{.Id}}' | grep -Eq '^sha256:[0-9a-f]{64}$' ||
    die 'declared exact image digest is not present locally'
}

require_container_health() {
  local container="$1" health_value
  health_value="$(docker inspect "$container" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}')"
  [ "$health_value" = healthy ] || die "$container is not healthy"
}

verify_public_provenance_from() {
  local run_id="$1" source="$2" body source_sha app_ref config_sha origin root releases
  root="$(artifact_transaction "$run_id")/$source"
  if [ "$source" = candidate ]; then
    releases="$(artifact_transaction "$run_id")/next-service-releases.json"
  elif [ "$source" = prior ]; then
    releases="$root/service-releases.json"
  else
    die 'invalid provenance source'
  fi
  source_sha="$(jq -er '.app.sourceSha' "$releases")"
  validate_sha "$source_sha"
  app_ref="$(jq -er '.app.imageRef' "$releases")"
  config_sha="sha256:$(sha256sum "$root/target-public-config.json" | cut -d' ' -f1)"
  origin="$(jq -er '.publicOrigin' "$root/target-public-config.json")"
  for url in 'http://127.0.0.1:3000/api/health' "$origin/api/health"; do
    body="$(curl --fail --silent --show-error --max-time 10 "$url")"
    jq -e --arg sha "$source_sha" --arg artifact "$app_ref" --arg config "$config_sha" --arg origin "$origin" \
      '.status=="ok" and .gitSha==$sha and .artifactDigest==$artifact and .configProfileSha256==$config and .publicOrigin==$origin' \
      <<<"$body" >/dev/null || die "public health provenance mismatch at $url"
  done
}

verify_public_provenance() {
  verify_public_provenance_from "$1" candidate
}

verify_release_runtime_state() {
  local run_id="$1" source="$2" container service releases
  verify_runtime_profile "$run_id" "$source"
  if [ "$source" = candidate ]; then
    releases="$(artifact_transaction "$run_id")/next-service-releases.json"
  else
    releases="$(artifact_transaction "$run_id")/prior/service-releases.json"
  fi
  while read -r container service; do
    verify_container_image "$container" "$(jq -er --arg service "$service" '.[$service].imageRef' "$releases")"
  done <<'EOF'
beacon-app app
beacon-commerce-reconciler commerce-reconciler
beacon-tapestry tapestry
beacon-playlist-bot playlist-bot
EOF
  verify_container_image beacon-postgres "$(artifact_ref_from "$run_id" "$source" externalImages postgres)"
  verify_container_image beacon-livekit "$(artifact_ref_from "$run_id" "$source" externalImages livekit)"
  verify_pulled_image "$(jq -er '.analytics.imageRef' "$releases")"
  for container in beacon-app beacon-commerce-reconciler beacon-tapestry beacon-playlist-bot beacon-postgres; do
    require_container_health "$container"
  done
  curl --fail --silent --show-error --max-time 5 --output /dev/null http://127.0.0.1:7880 ||
    die 'beacon-livekit health endpoint failed'
  curl --fail --silent --show-error --max-time 10 http://127.0.0.1:3000/api/health/ready >/dev/null ||
    die 'application readiness endpoint failed'
  verify_public_provenance_from "$run_id" "$source"
  boundary
}

artifact_status() {
  local run_id="$1" target="$2" transaction archive
  if [ "$target" = production ]; then require_release_lane oci-production; fi
  if [ "$target" = production ] && transaction_finish_committed "$run_id"; then return 0; fi
  if [ "$target" = shadow ]; then
    local cleanup_mode="${SHADOW_CLEANUP_MODE:-source}" receipt archive
    receipt="${DELIVERY_RECEIPT:-$(artifact_receipt "$run_id")}"
    if [ "$cleanup_mode" = terminal ]; then
      transaction_require_shadow_cleanup "$run_id" "$receipt"
      jq -r '.imageRefs | to_entries[] | "artifact=\(.key) ref=\(.value)"' "$receipt"
      return 0
    fi
    if [ "$cleanup_mode" = archive ]; then
      archive="$SHADOW_CLEANUP_ARCHIVE"
      transaction_require_shadow_cleanup "$run_id" "$receipt" "$archive"
      persist_shadow_cleanup_receipt "$run_id" "$receipt"
      jq -r '.imageRefs | to_entries[] | "artifact=\(.key) ref=\(.value)"' "$receipt"
    else
      transaction_require "$run_id" "$target" prepared shadowed
      if [ "$(transaction_phase "$run_id")" = prepared ]; then
        artifact_compose "$run_id" config --quiet
        transaction_set_phase "$run_id" shadowed
        test_failpoint shadowed-phase-persisted
      fi
      receipt="$(artifact_receipt "$run_id")"
      persist_shadow_cleanup_receipt "$run_id" "$receipt"
      jq -r '.imageRefs | to_entries[] | "artifact=\(.key) ref=\(.value)"' "$receipt"
      transaction="$(artifact_transaction "$run_id")"
      archive="${transaction}.shadowed.${DELIVERY_RUN_ID}-${DELIVERY_RUN_ATTEMPT}"
      [ ! -e "$archive" ] && [ ! -L "$archive" ] || die 'shadow cleanup archive already exists'
      mv -- "$transaction" "$archive"
      test_failpoint shadow-cleanup-rename
    fi
    sync -f "$TRANSACTION_ROOT"
    test_failpoint shadow-cleanup-first-parent-fsync
    rm -rf --one-file-system -- "$archive"
    test_failpoint shadow-cleanup-unlink
    sync -f "$TRANSACTION_ROOT"
    test_failpoint shadow-cleanup-final-parent-fsync
    return 0
  fi
  transaction_require "$run_id" "$target" prepared replaced
  [ "$(transaction_phase "$run_id")" = replaced ] || die 'production status requires a completed replacement'
  verify_release_runtime_state "$run_id" candidate
  atomic_install_current_state "$(artifact_transaction "$run_id")"
  transaction_set_phase "$run_id" committed
  transaction_clear_active "$run_id"
}

artifact_rollback() {
  local run_id="$1" phase transaction prior_app prior_worker preflight_ready=false migration_performed=false service temporary
  require_release_lane oci-production
  if transaction_finish_rolled_back "$run_id"; then return 0; fi
  transaction_require_rollback "$run_id"
  require_unchanged_runtime_inputs "$(artifact_transaction "$run_id")"
  bind_rollback_publication "$run_id"
  if [ ! -e "$ACTIVE_TRANSACTION" ]; then atomic_write_active_transaction "$run_id"; fi
  transaction="$(artifact_transaction "$run_id")"
  phase="$(transaction_phase "$run_id")"
  if [ -f "$transaction/migration-state.json" ] && [ "$(jq '.pending|length' "$transaction/migration-state.json")" -gt 0 ]; then
    migration_performed=true
  fi
  if [ "$migration_performed" = true ]; then
    artifact_compose "$run_id" stop app commerce-reconciler
    for _attempt in $(seq 1 30); do
      if artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
        npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null; then
        preflight_ready=true
        break
      fi
      sleep 2
    done
    [ "$preflight_ready" = true ] || die 'automatic rollback refused: durable grant state did not quiesce'
    artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
      npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null ||
      die 'automatic rollback refused: stable grant preflight failed'
    prior_app="$(jq -er '.app.imageRef' "$transaction/prior/service-releases.json")"
    prior_worker="$(jq -er '."commerce-reconciler".imageRef' "$transaction/prior/service-releases.json")"
    for ref in "$prior_app" "$prior_worker"; do
      docker run --rm --entrypoint test "$ref" -f /app/src/lib/stage-grant-effects.ts ||
        die 'automatic rollback refused: previous app/worker lacks durable grant contract'
      docker run --rm --entrypoint test "$ref" -f /app/scripts/stage-grant-rollback-preflight.ts ||
        die 'automatic rollback refused: previous app/worker lacks rollback preflight'
    done
  fi
  verify_runtime_profile "$run_id" prior
  while IFS= read -r service; do
    jq -e --arg service "$service" '.rolledBackServices | index($service)' "$transaction/receipt.json" >/dev/null && continue
    [ "$service" != analytics ] || die 'analytics uses its dedicated deployment lane'
    artifact_compose_service_from "$run_id" prior "$service" up -d --no-deps --force-recreate --no-build --pull never
    temporary="$transaction/receipt.json.new"
    jq --arg service "$service" '.rolledBackServices += [$service]' "$transaction/receipt.json" > "$temporary"
    chown root:root "$temporary"
    chmod 0600 "$temporary"
    sync -f "$temporary"
    mv -f -- "$temporary" "$transaction/receipt.json"
  done < <(jq -r --argjson migration "$migration_performed" '(.replacedServices + (if $migration then ["app","commerce-reconciler"] else [] end)) | unique[]' "$transaction/receipt.json")
  for _attempt in $(seq 1 60); do
    if [ "$(health beacon-app 2>/dev/null || true)" = healthy ] && \
       [ "$(health beacon-commerce-reconciler 2>/dev/null || true)" = healthy ] && \
       [ "$(health beacon-tapestry 2>/dev/null || true)" = healthy ] && \
       [ "$(docker inspect beacon-playlist-bot --format '{{.State.Health.Status}}' 2>/dev/null || true)" = healthy ] && \
       curl --fail --silent --show-error http://127.0.0.1:3000/api/health/ready >/dev/null; then
      restored_ready=true
      break
    fi
    sleep 2
  done
  [ "$restored_ready" = true ] ||
    die 'rollback services did not become ready; writers remain contained for forward repair'
  verify_release_runtime_state "$run_id" prior
  # The runtime verification above must succeed before the prior exact state is
  # republished as the root-owned high-water.
  atomic_install_release_state "$(artifact_transaction "$run_id")" prior
  transaction_set_phase "$run_id" rolled-back
  if [ -e "$ACTIVE_TRANSACTION" ]; then transaction_clear_active "$run_id"; fi
  return 0
}

schedule_apply() {
  local request_id="$1" request expected
  validate_uuid "$request_id"
  request="$SCHEDULE_REQUEST_ROOT/${request_id}.json"
  require_secure_root_file "$request" 600
  jq -e --arg request "$request_id" '
    type=="object" and (keys|sort)==(["actorUserId","expectedScheduledAt","reason","requestId","scheduledAt","schemaVersion","scope","sessionId"]|sort) and
    .schemaVersion=="harmonic-beacon.schedule-operation.v1" and .scope=="synthetic-rehearsal" and .requestId==$request
  ' "$request" >/dev/null || die 'schedule operation request is invalid'
  require_secure_root_file "$CURRENT_STATE" 600
  expected="$(jq -er '.serviceReleases.app.imageRef' "$CURRENT_STATE")"
  verify_container_image beacon-app "$expected"
  docker exec -i beacon-app npx tsx scripts/authorized-session-schedule.ts < "$request"
}

usage() {
  printf '%s\n' 'usage: hb-deploy artifact-{prepare|impact|preflight|migrate|replace|status|authorize-rollback|rollback} DELIVERY_RUN_ID DELIVERY_ATTEMPT ...; hb-deploy schedule-apply REQUEST_ID; hb-deploy {health|boundary} ...' >&2
  exit 2
}

require_root
umask 077
cd /
[ "$#" -gt 0 ] || usage
command="$1"
shift

case "$command" in
  artifact-*)
    unset NODE_OPTIONS NODE_PATH GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_DIR GIT_WORK_TREE \
      DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME \
      SSL_CERT_FILE SSL_CERT_DIR GITHUB_TOKEN GH_TOKEN
    export HOME=/root
    verify_installed_implementation
    [ "$#" -ge 3 ] || usage
    readonly DELIVERY_RUN_ID="$1" DELIVERY_RUN_ATTEMPT="$2"
    validate_run_id "$DELIVERY_RUN_ID"
    [[ "$DELIVERY_RUN_ATTEMPT" =~ ^[1-9][0-9]{0,9}$ ]] || die 'invalid delivery attempt'
    shift 2
    ;;
  schedule-apply)
    unset NODE_OPTIONS NODE_PATH GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_DIR GIT_WORK_TREE \
      DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME \
      SSL_CERT_FILE SSL_CERT_DIR GITHUB_TOKEN GH_TOKEN
    export HOME=/root
    verify_installed_implementation
    ;;
esac

# Both lanes serialize against the same lock. Root lane-state changes must take
# this lock before replacing RELEASE_LANE_STATE.
require_secure_root_ancestors "$ARTIFACT_STATE/.transaction.lock"
if [ -e "$TRANSACTION_ROOT" ] || [ -L "$TRANSACTION_ROOT" ]; then
  require_secure_root_ancestors "$TRANSACTION_ROOT/.probe"
fi
install -d -o root -g root -m 0700 "$ARTIFACT_STATE" "$TRANSACTION_ROOT"
exec 9>"$ARTIFACT_STATE/.transaction.lock"
flock -x 9

case "$command" in
  health) [ "$#" -eq 1 ] || usage; health "$@" ;;
  boundary) [ "$#" -eq 0 ] || usage; boundary ;;
  artifact-prepare) [ "$#" -eq 8 ] || usage; artifact_prepare "$@" ;;
  artifact-impact) [ "$#" -eq 2 ] || usage; require_delivery_invocation "$1" "$2" preflight; artifact_impact "$@" ;;
  artifact-preflight) [ "$#" -eq 2 ] || usage; require_delivery_invocation "$1" "$2" preflight; artifact_preflight "$@" ;;
  artifact-migrate) [ "$#" -eq 1 ] || usage; require_delivery_invocation "$1" production migrate; artifact_migrate "$@" ;;
  artifact-replace) [ "$#" -eq 1 ] || usage; require_delivery_invocation "$1" production replace; artifact_replace "$@" ;;
  artifact-status) [ "$#" -eq 2 ] || usage; require_delivery_invocation "$1" "$2" status; artifact_status "$@" ;;
  artifact-authorize-rollback) [ "$#" -eq 1 ] || usage; artifact_authorize_rollback "$@" ;;
  artifact-rollback) [ "$#" -eq 1 ] || usage; require_delivery_invocation "$1" production rollback; artifact_rollback "$@" ;;
  schedule-apply) [ "$#" -eq 1 ] || usage; schedule_apply "$@" ;;
  *) usage ;;
esac
