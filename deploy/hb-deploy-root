#!/usr/bin/env bash

# Root-owned deployment entrypoint for the dedicated mona Actions runner.
# The runner may invoke this file through sudo, but cannot invoke Docker or an
# arbitrary root shell directly. Keep every accepted argument fail-closed.

set -euo pipefail

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

readonly PRODUCTION_ENV='/etc/harmonic-beacon/production.env'
readonly COMMERCE_ENV='/etc/harmonic-beacon/commerce.env'
readonly ACCOUNT_ENV='/etc/harmonic-beacon/live-production-secrets/account.env'
readonly CANDIDATE_PARENT='/opt/actions-runner/_work/harmonic-beacon-webapp/harmonic-beacon-webapp/.hb-artifacts'
readonly PRIVATE_NETWORK='pmp_beacon_internal'
readonly EXPECTED_NETWORK_MEMBERS=$'beacon-app\npmp-myth-worker\npmp-myth-worker-secondary'
readonly ARTIFACT_VERIFY='/usr/local/libexec/harmonic-beacon/hb-artifact-verify'
readonly RELEASE_MANIFEST='/usr/local/libexec/harmonic-beacon/release-manifest.mjs'
readonly TRUSTED_IMPLEMENTATION='/usr/local/libexec/harmonic-beacon/ops-d-implementation.sha256'
readonly ARTIFACT_STATE='/var/lib/harmonic-beacon/releases'
readonly CURRENT_STATE="$ARTIFACT_STATE/current-state.json"
readonly TRANSACTION_ROOT="$ARTIFACT_STATE/transactions"
readonly ACTIVE_TRANSACTION="$ARTIFACT_STATE/active-transaction"
readonly TRANSITION_EVIDENCE="$ARTIFACT_STATE/transition-evidence"
readonly TRUSTED_COMPOSE='/usr/local/libexec/harmonic-beacon/docker-compose.yml'
readonly TRUSTED_OVERLAY='/usr/local/libexec/harmonic-beacon/oci-images.compose.yml'
readonly REGISTRY_ENV='/etc/harmonic-beacon/registry.env'
readonly RELEASE_LANE_STATE='/etc/harmonic-beacon/release-lane-state'

die() {
  printf 'hb-deploy: %s\n' "$*" >&2
  exit 1
}

# Deterministic crash-boundary injection for the unprivileged state-machine
# harness. Root invocations can never activate these hooks.
test_failpoint() {
  local boundary="$1"
  if [ "${EUID}" -ne 0 ] && [ "${HB_DEPLOY_TEST_FAILPOINT:-}" = "$boundary" ]; then
    die "injected test failure after $boundary"
  fi
}

require_root() {
  [ "${EUID}" -eq 0 ] || die 'must run as root through the restricted sudo rule'
}

require_release_lane() {
  local expected="$1" actual
  case "$expected" in legacy-shadow | oci-production) ;; *) die 'invalid release lane' ;; esac
  require_secure_root_file "$RELEASE_LANE_STATE" 600
  actual="$(<"$RELEASE_LANE_STATE")"
  [ "$actual" = "$expected" ] || die "release lane changed; refusing $expected mutation"
}

validate_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die 'invalid commit SHA'
}

validate_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || die 'invalid SHA-256'
}

validate_digest() {
  [[ "$1" =~ ^sha256:[0-9a-f]{64}$ ]] || die 'invalid digest'
}

validate_image_ref() {
  [[ "$1" =~ ^[a-z0-9./-]+@sha256:[0-9a-f]{64}$ ]] || die 'invalid exact image reference'
}

validate_target() {
  [ "$1" = shadow ] || [ "$1" = production ] || die 'invalid artifact target'
}

validate_run_id() {
  [[ "$1" =~ ^[1-9][0-9]{0,19}$ ]] || die 'invalid Actions run id'
}

validate_container() {
  case "$1" in
    beacon-app | beacon-commerce-reconciler | beacon-tapestry) ;;
    *) die 'container is not in the deploy health allowlist' ;;
  esac
}

network_members() {
  docker network inspect "$PRIVATE_NETWORK" \
    --format '{{range .Containers}}{{println .Name}}{{end}}' |
    sed '/^[[:space:]]*$/d' |
    sort
}

require_exact_private_network() {
  local members

  [ "$(docker network inspect "$PRIVATE_NETWORK" --format '{{.Internal}}')" = true ] ||
    die 'commerce network is not internal'
  members="$(network_members)"
  if [ "$members" != "$EXPECTED_NETWORK_MEMBERS" ]; then
    printf 'Unexpected %s members:\n%s\n' "$PRIVATE_NETWORK" "$members" >&2
    exit 1
  fi
}

container_has_env_name() {
  docker inspect "$1" \
    --format '{{range .Config.Env}}{{println .}}{{end}}' |
    cut -d= -f1 |
    grep -Fxq "$2"
}

container_has_commerce_key() {
  docker inspect "$1" \
    --format '{{range .Config.Env}}{{println .}}{{end}}' |
    cut -d= -f1 |
    grep -Eq '^BEACON_COMMERCE_SERVICE_KEY_'
}

health() {
  validate_container "$1"
  docker inspect "$1" --format '{{.State.Health.Status}}'
}

boundary() {
  require_exact_private_network
  container_has_env_name beacon-app BEACON_COMMERCE_SERVICE_KEY_CURRENT_ID ||
    die 'app is missing commerce key id'
  container_has_env_name beacon-app BEACON_COMMERCE_SERVICE_KEY_CURRENT ||
    die 'app is missing commerce key'

  for container in beacon-postgres beacon-livekit beacon-playlist-bot \
    beacon-tapestry beacon-commerce-reconciler pmp-myth-api \
    pmp-myth-worker pmp-myth-worker-secondary pmp-myth-postgres \
    pmp-myth-waha pmp-myth-rag pmp-myth-gateway; do
    if docker inspect "$container" >/dev/null 2>&1 && container_has_commerce_key "$container"; then
      die "commerce bearer reached unexpected container: $container"
    fi
  done

  if [ -e "$ACCOUNT_ENV" ]; then
    [ "$(docker inspect beacon-app --format '{{range .Config.Env}}{{println .}}{{end}}' |
      sed -n 's/^BEACON_ACCOUNT_ENABLED=//p' | tail -n 1)" = true ] ||
      die 'app has Account secrets but Account is not enabled'
    container_has_env_name beacon-app BEACON_ACCOUNT_CLIENT_SECRET ||
      die 'app is missing the Account client secret'
  elif container_has_env_name beacon-app BEACON_ACCOUNT_CLIENT_SECRET; then
    die 'app received Account secrets without the root-owned bundle'
  fi
  for container in beacon-postgres beacon-livekit beacon-playlist-bot \
    beacon-tapestry beacon-commerce-reconciler; do
    if container_has_env_name "$container" BEACON_ACCOUNT_CLIENT_SECRET; then
      die "Account RP secret reached unexpected container: $container"
    fi
  done
}

artifact_transaction() {
  printf '%s/transactions/%s\n' "$ARTIFACT_STATE" "$1"
}

artifact_receipt() {
  printf '%s/receipt.json\n' "$(artifact_transaction "$1")"
}

require_secure_root_ancestors() {
  local ancestor
  ancestor="$(dirname -- "$1")"
  while :; do
    [ -d "$ancestor" ] && [ ! -L "$ancestor" ] || die 'unsafe root-owned ancestor'
    [ "$(stat -c '%u:%g' "$ancestor")" = 0:0 ] || die 'ancestor is not root-owned'
    (( (8#$(stat -c '%a' "$ancestor") & 0022) == 0 )) || die 'ancestor is writable'
    [ "$ancestor" != / ] || break
    ancestor="$(dirname -- "$ancestor")"
  done
}

require_secure_root_file() {
  local path="$1" mode="$2"
  require_secure_root_ancestors "$path"
  [ -f "$path" ] && [ ! -L "$path" ] || die "root-owned file is missing or unsafe: $path"
  [ "$(stat -c '%U:%G:%a' "$path")" = "root:root:$mode" ] ||
    die "root-owned file ownership or mode is invalid: $path"
}

verify_installed_implementation() {
  local digest path expected_mode helper_seen=false verifier_seen=false module_seen=false compose_seen=false overlay_seen=false
  require_secure_root_file "$TRUSTED_IMPLEMENTATION" 600
  while read -r digest path; do
    validate_sha256 "$digest"
    case "$path" in
      /usr/local/sbin/hb-deploy)
        [ "$helper_seen" = false ] || die 'duplicate helper trust entry'
        helper_seen=true; expected_mode=755
        ;;
      "$ARTIFACT_VERIFY")
        [ "$verifier_seen" = false ] || die 'duplicate verifier trust entry'
        verifier_seen=true; expected_mode=755
        ;;
      "$RELEASE_MANIFEST")
        [ "$module_seen" = false ] || die 'duplicate manifest-module trust entry'
        module_seen=true; expected_mode=644
        ;;
      "$TRUSTED_COMPOSE")
        [ "$compose_seen" = false ] || die 'duplicate Compose trust entry'
        compose_seen=true; expected_mode=644
        ;;
      "$TRUSTED_OVERLAY")
        [ "$overlay_seen" = false ] || die 'duplicate overlay trust entry'
        overlay_seen=true; expected_mode=644
        ;;
      *) die 'trusted implementation manifest contains an unexpected path' ;;
    esac
    require_secure_root_file "$path" "$expected_mode"
  done < "$TRUSTED_IMPLEMENTATION"
  [ "$helper_seen:$verifier_seen:$module_seen:$compose_seen:$overlay_seen" = true:true:true:true:true ] ||
    die 'trusted implementation manifest must bind each required file exactly once'
  sha256sum --check --strict "$TRUSTED_IMPLEMENTATION" >/dev/null ||
    die 'installed privileged implementation digest mismatch'
}

require_current_state() {
  require_secure_root_file "$CURRENT_STATE" 600
  node "$RELEASE_MANIFEST" validate-current-state --state "$CURRENT_STATE" ||
    die 'invalid OCI current state; separately reviewed root-owned reconciliation is required'
}

state_unpack() {
  local state="$1" destination="$2"
  require_secure_root_file "$state" 600
  install -d -o root -g root -m 0700 "$destination"
  node "$RELEASE_MANIFEST" unpack-current-state --state "$state" --destination "$destination" ||
    die 'invalid OCI current state; separately reviewed root-owned reconciliation is required'
}

verify_prior_state_inputs() {
  local destination="$1" expected actual
  while read -r field file; do
    expected="$(jq -er ".$field" "$destination/prior-manifest.json")"
    validate_digest "$expected"
    actual="sha256:$(sha256sum "$destination/$file" | cut -d' ' -f1)"
    [ "$actual" = "$expected" ] || die "root-owned prior state input mismatch: $file"
  done <<'EOF'
deploymentInputs.composeSha256 docker-compose.yml
deploymentInputs.overlaySha256 oci-images.compose.yml
configProfiles.production.sha256 target-public-config.json
EOF
}

require_rollback_safe_public_config() {
  local candidate="$1" prior="$2"
  cmp --silent "$candidate" "$prior" ||
    die 'public runtime config change requires a separately reviewed transactional overlay'
}

require_oci_transition_evidence() {
  local manifest="$1" stage file
  for file in authorization.json qualification.json shadow.json rollback.json forward-repair.json \
    shadow.execution.json rollback.execution.json forward-repair.execution.json \
    shadow.signature.bundle.json rollback.signature.bundle.json forward-repair.signature.bundle.json; do
    require_secure_root_file "$TRANSITION_EVIDENCE/$file" 600
  done
  for stage in shadow rollback forward-repair; do
    cosign verify-blob \
      --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' \
      --certificate-identity 'https://github.com/AlterMundi/harmonic-beacon-webapp/.github/workflows/oci-promote.yml@refs/heads/main' \
      --bundle "$TRANSITION_EVIDENCE/$stage.signature.bundle.json" \
      "$TRANSITION_EVIDENCE/$stage.json" >/dev/null || die 'transition receipt authentication failed'
  done
  node "$RELEASE_MANIFEST" validate-transition --manifest "$manifest" --evidence "$TRANSITION_EVIDENCE" ||
    die 'transition semantic validation failed'
}

atomic_install_release_state() {
  local transaction="$1" source="$2" root manifest manifest_sha expected temporary
  require_release_lane oci-production
  root="$transaction/$source"
  case "$source" in
    candidate)
      manifest="$root/candidate-manifest.json"
      expected="$(jq -er '.manifestSha256' "$transaction/receipt.json")"
      ;;
    prior)
      manifest="$root/prior-manifest.json"
      expected="$(jq -er '.baseManifestSha256' "$transaction/receipt.json")"
      verify_prior_state_inputs "$root"
      ;;
    *) die 'invalid release state source' ;;
  esac
  validate_sha256 "$expected"
  manifest_sha="$(sha256sum "$manifest" | cut -d' ' -f1)"
  [ "$manifest_sha" = "$expected" ] || die 'release state manifest digest mismatch'
  temporary="$(mktemp --tmpdir="$ARTIFACT_STATE" '.current-state.XXXXXX')"
  jq -n --arg manifestSha256 "$manifest_sha" \
    --arg manifestBase64 "$(base64 -w0 "$manifest")" \
    --arg composeBase64 "$(base64 -w0 "$root/docker-compose.yml")" \
    --arg overlayBase64 "$(base64 -w0 "$root/oci-images.compose.yml")" \
    --arg publicConfigBase64 "$(base64 -w0 "$root/target-public-config.json")" \
    '{schemaVersion:"harmonic-beacon.current-state.v3",laneState:"oci-production",manifestSha256:$manifestSha256,manifestBase64:$manifestBase64,composeBase64:$composeBase64,overlayBase64:$overlayBase64,publicConfigBase64:$publicConfigBase64}' \
    > "$temporary"
  node "$RELEASE_MANIFEST" validate-current-state --state "$temporary" || {
    rm -f -- "$temporary"
    die 'refusing contradictory release state publication'
  }
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  test_failpoint current-state-file-fsync
  mv -f -- "$temporary" "$CURRENT_STATE"
  test_failpoint current-state-rename
  sync -f "$ARTIFACT_STATE"
  test_failpoint current-state-directory-fsync
}

atomic_install_current_state() {
  atomic_install_release_state "$1" candidate
}

atomic_write_active_transaction() {
  local run_id="$1" temporary
  validate_run_id "$run_id"
  temporary="$(mktemp --tmpdir="$ARTIFACT_STATE" '.active-transaction.XXXXXX')"
  printf '%s\n' "$run_id" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  mv -f -- "$temporary" "$ACTIVE_TRANSACTION"
  sync -f "$ARTIFACT_STATE"
}

transaction_phase() {
  jq -er '.phase' "$(artifact_receipt "$1")"
}

transaction_set_phase() {
  local run_id="$1" phase="$2" receipt temporary
  receipt="$(artifact_receipt "$run_id")"
  temporary="${receipt}.new"
  jq --arg phase "$phase" '.phase=$phase' "$receipt" > "$temporary"
  chown root:root "$temporary"
  chmod 0600 "$temporary"
  sync -f "$temporary"
  test_failpoint phase-marker-file-fsync
  mv -f -- "$temporary" "$receipt"
  test_failpoint phase-marker-rename
  sync -f "$(artifact_transaction "$run_id")"
  test_failpoint phase-marker-directory-fsync
}

transaction_require() {
  local run_id="$1" target="$2"
  shift 2
  local receipt phase allowed=false base current
  validate_run_id "$run_id"
  validate_target "$target"
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  [ "$(jq -er '.target' "$receipt")" = "$target" ] || die 'prepared transaction target mismatch'
  phase="$(transaction_phase "$run_id")"
  for expected in "$@"; do [ "$phase" = "$expected" ] && allowed=true; done
  [ "$allowed" = true ] || die "transaction phase $phase does not authorize this command"
  require_current_state
  [ "$(jq -er '.laneState' "$CURRENT_STATE")" = oci-production ] || die 'live high-water is not OCI production'
  base="$(jq -er '.baseManifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$base" = "$current" ] || die 'prepared transaction no longer matches current high-water'
  if [ "$target" = production ]; then
    require_release_lane oci-production
    require_secure_root_file "$ACTIVE_TRANSACTION" 600
    [ "$(<"$ACTIVE_TRANSACTION")" = "$run_id" ] || die 'a different production transaction is active'
  else
    require_release_lane legacy-shadow
    [ ! -e "$ACTIVE_TRANSACTION" ] || die 'production transaction is active during shadow verification'
  fi
}

transaction_require_rollback() {
  local run_id="$1" receipt phase base candidate current
  validate_run_id "$run_id"
  require_release_lane oci-production
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  [ "$(jq -er '.target' "$receipt")" = production ] || die 'rollback requires a production transaction'
  phase="$(transaction_phase "$run_id")"
  case "$phase" in
    migration-attempted | migrated | replaced | committed) ;;
    *) die "transaction phase $phase does not authorize rollback" ;;
  esac
  require_current_state
  [ "$(jq -er '.laneState' "$CURRENT_STATE")" = oci-production ] || die 'live high-water is not OCI production'
  base="$(jq -er '.baseManifestSha256' "$receipt")"
  candidate="$(jq -er '.manifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$current" = "$base" ] || [ "$current" = "$candidate" ] ||
    die 'rollback transaction does not match the live high-water'
  if [ -e "$ACTIVE_TRANSACTION" ]; then
    require_secure_root_file "$ACTIVE_TRANSACTION" 600
    [ "$(<"$ACTIVE_TRANSACTION")" = "$run_id" ] || die 'a different production transaction is active'
  else
    [ "$phase" = committed ] && [ "$current" = "$candidate" ] ||
      die 'rollback transaction is no longer active'
  fi
}

transaction_clear_active() {
  local run_id="$1"
  require_secure_root_file "$ACTIVE_TRANSACTION" 600
  [ "$(<"$ACTIVE_TRANSACTION")" = "$run_id" ] || die 'active transaction mismatch'
  rm -f -- "$ACTIVE_TRANSACTION"
  test_failpoint active-marker-remove
  sync -f "$ARTIFACT_STATE"
  test_failpoint active-marker-directory-fsync
}

transaction_resume_prepared() {
  local run_id="$1" sha="$2" tree="$3" manifest_sha="$4" config_sha="$5" workflow_attempt="$6"
  local receipt base current
  require_release_lane oci-production
  require_current_state
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  jq -e --arg run "$run_id" --arg sha "$sha" --arg tree "$tree" --arg manifest "$manifest_sha" \
    --arg config "$config_sha" --argjson attempt "$workflow_attempt" '
      .target=="production" and .phase=="prepared" and .workflowRunId==$run and
      .workflowRunAttempt==$attempt and .sourceSha==$sha and .sourceTree==$tree and
      .manifestSha256==$manifest and .targetConfigSha256==$config
    ' "$receipt" >/dev/null || die 'existing transaction does not match prepare retry'
  base="$(jq -er '.baseManifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$base" = "$current" ] || die 'prepared transaction no longer matches current high-water'
  if [ -e "$ACTIVE_TRANSACTION" ]; then
    require_secure_root_file "$ACTIVE_TRANSACTION" 600
    [ "$(<"$ACTIVE_TRANSACTION")" = "$run_id" ] || die 'a different production transaction is active'
  else
    verify_release_runtime_state "$run_id" prior
    atomic_write_active_transaction "$run_id"
  fi
}

transaction_resume_shadow() {
  local run_id="$1" sha="$2" tree="$3" manifest_sha="$4" config_sha="$5" workflow_attempt="$6"
  local receipt base current
  require_release_lane legacy-shadow
  require_current_state
  [ ! -e "$ACTIVE_TRANSACTION" ] || die 'production transaction is active during shadow verification'
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  jq -e --arg run "$run_id" --arg sha "$sha" --arg tree "$tree" --arg manifest "$manifest_sha" \
    --arg config "$config_sha" --argjson attempt "$workflow_attempt" '
      .target=="shadow" and (.phase=="prepared" or .phase=="shadowed") and
      .workflowRunId==$run and .workflowRunAttempt==$attempt and .sourceSha==$sha and
      .sourceTree==$tree and .manifestSha256==$manifest and .targetConfigSha256==$config
    ' "$receipt" >/dev/null || die 'existing shadow transaction does not match prepare retry'
  base="$(jq -er '.baseManifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$base" = "$current" ] || die 'shadow transaction no longer matches current high-water'
  verify_release_runtime_state "$run_id" prior
}

transaction_finish_committed() {
  local run_id="$1" receipt phase expected current
  validate_run_id "$run_id"
  require_release_lane oci-production
  require_current_state
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  [ "$(jq -er '.target' "$receipt")" = production ] || return 1
  phase="$(transaction_phase "$run_id")"
  [ "$phase" = replaced ] || [ "$phase" = committed ] || return 1
  expected="$(jq -er '.manifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$current" = "$expected" ] || return 1
  if [ -e "$ACTIVE_TRANSACTION" ]; then
    require_secure_root_file "$ACTIVE_TRANSACTION" 600
    [ "$(<"$ACTIVE_TRANSACTION")" = "$run_id" ] || die 'a different production transaction is active'
  else
    [ "$phase" = committed ] || die 'commit transaction is no longer active'
  fi
  verify_release_runtime_state "$run_id" candidate || die 'committed runtime verification failed'
  if [ "$phase" = replaced ]; then transaction_set_phase "$run_id" committed; fi
  if [ -e "$ACTIVE_TRANSACTION" ]; then transaction_clear_active "$run_id"; fi
  return 0
}

transaction_finish_rolled_back() {
  local run_id="$1" receipt base current
  validate_run_id "$run_id"
  require_release_lane oci-production
  require_current_state
  receipt="$(artifact_receipt "$run_id")"
  require_secure_root_file "$receipt" 600
  [ "$(jq -er '.target' "$receipt")" = production ] || return 1
  [ "$(transaction_phase "$run_id")" = rolled-back ] || return 1
  base="$(jq -er '.baseManifestSha256' "$receipt")"
  current="$(jq -er '.manifestSha256' "$CURRENT_STATE")"
  [ "$current" = "$base" ] || die 'rolled-back transaction contradicts current high-water'
  verify_release_runtime_state "$run_id" prior || die 'rolled-back runtime verification failed'
  if [ -e "$ACTIVE_TRANSACTION" ]; then transaction_clear_active "$run_id"; fi
  return 0
}

manifest_ref() {
  local manifest="$1" section="$2" key="$3" value
  value="$(jq -er --arg key "$key" ".${section}[] | select((.artifactId // .serviceId)==\$key) | \"\(.repository)@\(.digest)\"" "$manifest")" ||
    die "manifest is missing ${section}.${key}"
  validate_image_ref "$value"
  printf '%s\n' "$value"
}

artifact_ref() {
  artifact_ref_from "$1" candidate "$2" "$3"
}

artifact_ref_from() {
  local run_id="$1" source="$2" section="$3" key="$4" manifest
  if [ "$source" = candidate ]; then
    manifest="$(artifact_transaction "$run_id")/candidate/candidate-manifest.json"
  elif [ "$source" = prior ]; then
    manifest="$(artifact_transaction "$run_id")/prior/prior-manifest.json"
  else
    die 'invalid artifact reference source'
  fi
  manifest_ref "$manifest" "$section" "$key"
}

artifact_compose_from() {
  local run_id="$1" source="$2"
  shift 2
  local root manifest app tapestry playlist analytics postgres livekit config_sha
  root="$(artifact_transaction "$run_id")/$source"
  if [ "$source" = candidate ]; then manifest="$root/candidate-manifest.json"; else manifest="$root/prior-manifest.json"; fi
  app="$(manifest_ref "$manifest" artifacts app)"
  tapestry="$(manifest_ref "$manifest" artifacts tapestry)"
  playlist="$(manifest_ref "$manifest" artifacts playlist-bot)"
  analytics="$(manifest_ref "$manifest" artifacts analytics)"
  postgres="$(manifest_ref "$manifest" externalImages postgres)"
  livekit="$(manifest_ref "$manifest" externalImages livekit)"
  config_sha="sha256:$(sha256sum "$root/target-public-config.json" | cut -d' ' -f1)"
  (
    cd "$root"
    HB_APP_IMAGE_REF="$app" HB_TAPESTRY_IMAGE_REF="$tapestry" \
      HB_PLAYLIST_IMAGE_REF="$playlist" HB_ANALYTICS_IMAGE_REF="$analytics" \
      HB_POSTGRES_IMAGE_REF="$postgres" HB_LIVEKIT_IMAGE_REF="$livekit" \
      HB_CONFIG_PROFILE_SHA256="$config_sha" \
      docker compose --file "$root/docker-compose.yml" \
      --file "$root/oci-images.compose.yml" --project-name app \
      --env-file "$PRODUCTION_ENV" "$@"
  )
}

artifact_compose() {
  artifact_compose_from "$1" candidate "${@:2}"
}

verify_runtime_profile() {
  local run_id="$1" source="${2:-candidate}" root expected
  root="$(artifact_transaction "$run_id")/$source"
  expected="sha256:$(sha256sum "$root/target-public-config.json" | cut -d' ' -f1)"
  node "$RELEASE_MANIFEST" verify-runtime-public-config \
    --profile "$root/target-public-config.json" --env "$PRODUCTION_ENV" \
    --expected-sha256 "$expected" >/dev/null || die 'runtime public config verification failed'
}

admit_file() {
  node "$RELEASE_MANIFEST" admit-file --source "$1" --output "$2" \
    --expected-sha256 "$3" --maximum-bytes "$4" >/dev/null
}

artifact_prepare() {
  local input_root="$1" sha="$2" tree="$3" run_id="$4" manifest_sha="$5"
  local target="$6" config_sha="$7" workflow_attempt="$8"
  local temp transaction profile artifact filename expected field
  validate_sha "$sha"
  validate_sha "$tree"
  validate_run_id "$run_id"
  [ "$input_root" = "$CANDIDATE_PARENT/$run_id/candidate" ] || die 'unexpected candidate artifact root'
  validate_sha256 "$manifest_sha"
  validate_target "$target"
  if [ "$target" = production ]; then
    require_release_lane oci-production
  else
    require_release_lane legacy-shadow
  fi
  validate_digest "$config_sha"
  [[ "$workflow_attempt" =~ ^[1-9][0-9]{0,9}$ ]] || die 'invalid workflow run attempt'
  require_current_state
  if [ "$target" = production ]; then
    [ "$(jq -er '.laneState' "$CURRENT_STATE")" = oci-production ] || die 'live high-water is not OCI production'
  fi
  require_secure_root_file "$REGISTRY_ENV" 600
  if [ "$target" = production ]; then require_secure_root_file "$PRODUCTION_ENV" 600; fi
  transaction="$(artifact_transaction "$run_id")"
  if [ -e "$transaction" ]; then
    if [ "$target" = production ]; then
      transaction_resume_prepared "$run_id" "$sha" "$tree" "$manifest_sha" "$config_sha" "$workflow_attempt"
    else
      transaction_resume_shadow "$run_id" "$sha" "$tree" "$manifest_sha" "$config_sha" "$workflow_attempt"
    fi
    return 0
  fi
  if [ -e "$ACTIVE_TRANSACTION" ]; then
    if [ "$target" = production ]; then die 'another production transaction is active'; fi
    die 'production transaction is active during shadow verification'
  fi

  temp="$(mktemp -d --tmpdir="$TRANSACTION_ROOT" '.prepare.XXXXXX')"
  # Capture the path now: EXIT can run after function-local variables unwind.
  trap "unset DOCKER_CONFIG HB_REGISTRY_TOKEN HB_REGISTRY_USERNAME; rm -rf -- $(printf '%q' "$temp")" EXIT
  install -d -o root -g root -m 0700 "$temp/candidate" "$temp/candidate/evidence" "$temp/prior" "$temp/docker"
  admit_file "$input_root/release-manifest.json" "$temp/candidate/candidate-manifest.json" "sha256:$manifest_sha" 1048576
  local manifest="$temp/candidate/candidate-manifest.json"
  # Parse only the admitted manifest; every remaining pathname is fixed here.
  admit_file "$input_root/qualification-receipt.json" "$temp/candidate/qualification-receipt.json" "$(jq -er '.qualification.receiptSha256' "$manifest")" 1048576
  admit_file "$input_root/docker-compose.yml" "$temp/candidate/docker-compose.yml" "$(jq -er '.deploymentInputs.composeSha256' "$manifest")" 4194304
  admit_file "$input_root/deploy/oci-images.compose.yml" "$temp/candidate/oci-images.compose.yml" "$(jq -er '.deploymentInputs.overlaySha256' "$manifest")" 4194304
  # Compose is active configuration: require the installed reviewed bytes too.
  cmp --silent "$TRUSTED_COMPOSE" "$temp/candidate/docker-compose.yml" || die 'unreviewed Compose input'
  cmp --silent "$TRUSTED_OVERLAY" "$temp/candidate/oci-images.compose.yml" || die 'unreviewed OCI overlay'
  for profile in production live-staging; do
    admit_file "$input_root/deploy/runtime-public-config/$profile.json" "$temp/candidate/$profile.json" "$(jq -er --arg profile "$profile" '.configProfiles[$profile].sha256' "$manifest")" 1048576
  done
  profile=production
  [ "$target" = production ] || profile=live-staging
  install -o root -g root -m 0600 "$temp/candidate/$profile.json" "$temp/candidate/target-public-config.json"
  for artifact in app tapestry playlist-bot analytics; do
    install -d -o root -g root -m 0700 "$temp/candidate/evidence/oci-evidence-$artifact"
    while read -r filename field; do
      expected="$(jq -er --arg id "$artifact" ".artifacts[] | select(.artifactId==\$id) | $field" "$manifest")"
      admit_file "$input_root/evidence/oci-evidence-$artifact/$filename" "$temp/candidate/evidence/oci-evidence-$artifact/$filename" "$expected" 16777216
    done <<'EOF'
evidence.json .evidenceRecordDigest
sbom.bundle.json .sbom.digest
sbom.signature.bundle.json .sbom.signatureBundleDigest
provenance.bundle.json .provenance.digest
provenance.signature.bundle.json .provenance.signatureBundleDigest
signature.bundle.json .signature.bundleDigest
EOF
  done
  install -o root -g root -m 0600 "$CURRENT_STATE" "$temp/prior-state.json"
  state_unpack "$temp/prior-state.json" "$temp/prior"
  verify_prior_state_inputs "$temp/prior"
  if [ "$target" = production ]; then
    require_rollback_safe_public_config \
      "$temp/candidate/target-public-config.json" "$temp/prior/target-public-config.json"
  fi

  export DOCKER_CONFIG="$temp/docker"
  local verifier_args=(
    --manifest "$temp/candidate/candidate-manifest.json" --evidence "$temp/candidate/evidence"
    --manifest-sha256 "$manifest_sha" --source-sha "$sha" --source-tree "$tree"
    --workflow-run-id "$run_id" --workflow-run-attempt "$workflow_attempt"
    --target "$target" --config-sha256 "$config_sha"
    --current-manifest "$temp/prior/prior-manifest.json"
    --compose "$temp/candidate/docker-compose.yml" --overlay "$temp/candidate/oci-images.compose.yml"
    --config-profile "$temp/candidate/target-public-config.json" --output "$temp/verified.json"
  )
  if [ "$target" = production ]; then verifier_args+=(--runtime-env "$PRODUCTION_ENV"); fi
  "$ARTIFACT_VERIFY" "${verifier_args[@]}"
  jq -e . "$temp/verified.json" >/dev/null || die 'artifact verifier emitted invalid receipt'
  if [ "$target" = production ]; then
    require_oci_transition_evidence "$temp/candidate/candidate-manifest.json"
  fi
  jq --arg target "$target" --arg phase prepared \
    '. + {target:$target,phase:$phase}' "$temp/verified.json" > "$temp/receipt.json"
  chmod 0600 "$temp/receipt.json"

  # The credential file is root-only and is never exposed to candidate code.
  # shellcheck disable=SC1090
  source "$REGISTRY_ENV"
  [ -n "${HB_REGISTRY_USERNAME:-}" ] && [ -n "${HB_REGISTRY_TOKEN:-}" ] || die 'registry credentials are incomplete'
  printf '%s' "$HB_REGISTRY_TOKEN" | docker login ghcr.io --username "$HB_REGISTRY_USERNAME" --password-stdin >/dev/null
  while IFS= read -r ref; do validate_image_ref "$ref"; docker pull "$ref" >/dev/null; done < <(
    jq -r '.artifacts[],.externalImages[] | "\(.repository)@\(.digest)"' "$temp/candidate/candidate-manifest.json"
  )
  unset HB_REGISTRY_TOKEN HB_REGISTRY_USERNAME
  rm -rf -- "$temp/docker" "$temp/prior-state.json" "$temp/verified.json"
  chmod 0700 "$temp"
  sync -f "$temp/receipt.json"
  # Reuse full live verification before this disposable transaction becomes
  # visible. Shadow evidence is meaningful only against the exact live base.
  (
    artifact_transaction() { printf '%s\n' "$temp"; }
    verify_release_runtime_state "$run_id" prior
  )
  mv -- "$temp" "$transaction"
  sync -f "$TRANSACTION_ROOT"
  if [ "$target" = production ]; then atomic_write_active_transaction "$run_id"; fi
  trap - EXIT
}

artifact_preflight() {
  local run_id="$1" target="$2"
  if [ "$target" = shadow ]; then
    transaction_require "$run_id" "$target" prepared shadowed
  else
    transaction_require "$run_id" "$target" prepared
  fi
  if [ "$target" = production ]; then
    [ -r "$PRODUCTION_ENV" ] || die 'production environment is not readable by root'
    [ -r "$COMMERCE_ENV" ] || die 'commerce environment is not readable by root'
    require_secure_root_file "$COMMERCE_ENV" 600
    if [ -e "$ACCOUNT_ENV" ]; then
      require_secure_root_file "$ACCOUNT_ENV" 600
      container_has_env_name beacon-app BEACON_ACCOUNT_ENABLED &&
        [ "$(docker inspect beacon-app --format '{{range .Config.Env}}{{println .}}{{end}}' |
          sed -n 's/^BEACON_ACCOUNT_ENABLED=//p' | tail -n 1)" = true ] ||
        die 'Account bundle exists before the supervised Account activation'
    fi
    if grep -Fxq 'E2E_DASHBOARD_ENABLED=1' "$PRODUCTION_ENV"; then
      die 'production E2E dashboard must be disabled before deploy'
    fi
    verify_runtime_profile "$run_id"
    require_exact_private_network
    artifact_compose "$run_id" config --quiet
    verify_container_image beacon-postgres "$(artifact_ref "$run_id" externalImages postgres)"
    verify_container_image beacon-livekit "$(artifact_ref "$run_id" externalImages livekit)"
  fi
}

artifact_migrate() {
  local run_id="$1"
  transaction_require "$run_id" production prepared
  verify_release_runtime_state "$run_id" prior
  transaction_set_phase "$run_id" migration-attempted
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  artifact_compose "$run_id" stop app
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate npx prisma migrate deploy
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/stage-grant-forward-drain.ts
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate npx prisma migrate status
  transaction_set_phase "$run_id" migrated
}

artifact_replace() {
  local run_id="$1"
  transaction_require "$run_id" production migrated
  verify_runtime_profile "$run_id"
  artifact_compose "$run_id" up -d --no-deps --force-recreate --no-build --pull never \
    app commerce-reconciler tapestry playlist-bot
  transaction_set_phase "$run_id" replaced
}

verify_container_image() {
  local container="$1" expected="$2" configured actual expected_id
  validate_image_ref "$expected"
  [ "$(docker inspect "$container" --format '{{.State.Running}}')" = true ] || die "$container is not running"
  configured="$(docker inspect "$container" --format '{{.Config.Image}}')"
  [ "$configured" = "$expected" ] || die "$container configured image does not match the manifest"
  actual="$(docker inspect "$container" --format '{{.Image}}')"
  expected_id="$(docker image inspect "$expected" --format '{{.Id}}')"
  [ -n "$actual" ] && [ "$actual" = "$expected_id" ] || die "$container actual image ID does not match the exact digest"
}

verify_pulled_image() {
  local expected="$1"
  validate_image_ref "$expected"
  docker image inspect "$expected" --format '{{.Id}}' | grep -Eq '^sha256:[0-9a-f]{64}$' ||
    die 'declared exact image digest is not present locally'
}

require_container_health() {
  local container="$1" health_value
  health_value="$(docker inspect "$container" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}')"
  [ "$health_value" = healthy ] || die "$container is not healthy"
}

verify_public_provenance_from() {
  local run_id="$1" source="$2" body source_sha app_ref config_sha origin root manifest
  root="$(artifact_transaction "$run_id")/$source"
  if [ "$source" = candidate ]; then
    manifest="$root/candidate-manifest.json"
  elif [ "$source" = prior ]; then
    manifest="$root/prior-manifest.json"
  else
    die 'invalid provenance source'
  fi
  source_sha="$(jq -er '.source.gitSha' "$manifest")"
  validate_sha "$source_sha"
  app_ref="$(artifact_ref_from "$run_id" "$source" artifacts app)"
  config_sha="sha256:$(sha256sum "$root/target-public-config.json" | cut -d' ' -f1)"
  origin="$(jq -er '.publicOrigin' "$root/target-public-config.json")"
  for url in 'http://127.0.0.1:3000/api/health' "$origin/api/health"; do
    body="$(curl --fail --silent --show-error --max-time 10 "$url")"
    jq -e --arg sha "$source_sha" --arg artifact "$app_ref" --arg config "$config_sha" --arg origin "$origin" \
      '.status=="ok" and .gitSha==$sha and .artifactDigest==$artifact and .configProfileSha256==$config and .publicOrigin==$origin' \
      <<<"$body" >/dev/null || die "public health provenance mismatch at $url"
  done
}

verify_public_provenance() {
  verify_public_provenance_from "$1" candidate
}

verify_release_runtime_state() {
  local run_id="$1" source="$2" container key section
  verify_runtime_profile "$run_id" "$source"
  while read -r container section key; do
    verify_container_image "$container" "$(artifact_ref_from "$run_id" "$source" "$section" "$key")"
  done <<'EOF'
beacon-app artifacts app
beacon-commerce-reconciler artifacts app
beacon-tapestry artifacts tapestry
beacon-playlist-bot artifacts playlist-bot
beacon-postgres externalImages postgres
beacon-livekit externalImages livekit
EOF
  verify_pulled_image "$(artifact_ref_from "$run_id" "$source" artifacts analytics)"
  for container in beacon-app beacon-commerce-reconciler beacon-tapestry beacon-playlist-bot beacon-postgres; do
    require_container_health "$container"
  done
  curl --fail --silent --show-error --max-time 5 --output /dev/null http://127.0.0.1:7880 ||
    die 'beacon-livekit health endpoint failed'
  curl --fail --silent --show-error --max-time 10 http://127.0.0.1:3000/api/health/ready >/dev/null ||
    die 'application readiness endpoint failed'
  verify_public_provenance_from "$run_id" "$source"
  boundary
}

artifact_status() {
  local run_id="$1" target="$2" transaction archive
  if [ "$target" = production ]; then require_release_lane oci-production; fi
  if [ "$target" = production ] && transaction_finish_committed "$run_id"; then return 0; fi
  if [ "$target" = shadow ]; then
    transaction_require "$run_id" "$target" prepared shadowed
    artifact_compose "$run_id" config --quiet
    if [ "$(transaction_phase "$run_id")" = prepared ]; then
      transaction_set_phase "$run_id" shadowed
    fi
    jq -r '.imageRefs | to_entries[] | "artifact=\(.key) ref=\(.value)"' "$(artifact_receipt "$run_id")"
    # Shadow never mutates live state. Atomically vacate the production run-id
    # namespace after its exact-base check so the same qualified candidate can
    # be promoted. A crash leaves either the resumable source transaction or an
    # irrelevant uniquely named discard directory, never a conflicting half-tree.
    transaction="$(artifact_transaction "$run_id")"
    archive="${transaction}.shadowed.${BASHPID}"
    mv -- "$transaction" "$archive"
    sync -f "$TRANSACTION_ROOT"
    rm -rf -- "$archive"
    sync -f "$TRANSACTION_ROOT"
    return 0
  fi
  transaction_require "$run_id" "$target" prepared replaced
  [ "$(transaction_phase "$run_id")" = replaced ] || die 'production status requires a completed replacement'
  verify_release_runtime_state "$run_id" candidate
  atomic_install_current_state "$(artifact_transaction "$run_id")"
  transaction_set_phase "$run_id" committed
  transaction_clear_active "$run_id"
}

artifact_rollback() {
  local run_id="$1" prior_app preflight_ready=false restored_ready=false
  require_release_lane oci-production
  if transaction_finish_rolled_back "$run_id"; then return 0; fi
  transaction_require_rollback "$run_id"
  # A rollback of an already committed release has no active marker. Publish
  # durable rollback intent before the first side effect so every later crash
  # can resume against the same transaction and base high-water.
  if [ ! -e "$ACTIVE_TRANSACTION" ]; then atomic_write_active_transaction "$run_id"; fi
  artifact_compose "$run_id" stop app
  for _attempt in $(seq 1 30); do
    if artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
      npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null; then
      preflight_ready=true
      break
    fi
    sleep 2
  done
  [ "$preflight_ready" = true ] || {
    docker stop beacon-commerce-reconciler 2>/dev/null || true
    die 'automatic rollback refused: durable grant state did not quiesce'
  }
  docker stop beacon-commerce-reconciler 2>/dev/null || true
  artifact_compose "$run_id" run --rm --no-deps --no-build --pull never migrate \
    npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null ||
    die 'automatic rollback refused: stable grant preflight failed'

  prior_app="$(manifest_ref "$(artifact_transaction "$run_id")/prior/prior-manifest.json" artifacts app)"
  docker run --rm --entrypoint test "$prior_app" -f /app/src/lib/stage-grant-effects.ts ||
    die 'automatic rollback refused: previous app lacks durable grant contract'
  docker run --rm --entrypoint test "$prior_app" -f /app/scripts/stage-grant-rollback-preflight.ts ||
    die 'automatic rollback refused: previous worker lacks rollback preflight'
  verify_runtime_profile "$run_id" prior
  artifact_compose_from "$run_id" prior up -d --no-deps --force-recreate --no-build --pull never \
    app commerce-reconciler tapestry playlist-bot
  for _attempt in $(seq 1 60); do
    if [ "$(health beacon-app 2>/dev/null || true)" = healthy ] && \
       [ "$(health beacon-commerce-reconciler 2>/dev/null || true)" = healthy ] && \
       [ "$(health beacon-tapestry 2>/dev/null || true)" = healthy ] && \
       [ "$(docker inspect beacon-playlist-bot --format '{{.State.Health.Status}}' 2>/dev/null || true)" = healthy ] && \
       curl --fail --silent --show-error http://127.0.0.1:3000/api/health/ready >/dev/null; then
      restored_ready=true
      break
    fi
    sleep 2
  done
  [ "$restored_ready" = true ] ||
    die 'rollback services did not become ready; writers remain contained for forward repair'
  verify_release_runtime_state "$run_id" prior
  # The runtime verification above must succeed before the prior exact state is
  # republished as the root-owned high-water.
  atomic_install_release_state "$(artifact_transaction "$run_id")" prior
  transaction_set_phase "$run_id" rolled-back
  if [ -e "$ACTIVE_TRANSACTION" ]; then transaction_clear_active "$run_id"; fi
  return 0
}

usage() {
  printf '%s\n' 'usage: hb-deploy {health|boundary|artifact-prepare|artifact-preflight|artifact-migrate|artifact-replace|artifact-status|artifact-rollback} ...' >&2
  exit 2
}

require_root
umask 077
cd /
[ "$#" -gt 0 ] || usage
command="$1"
shift

case "$command" in
  artifact-*)
    unset NODE_OPTIONS NODE_PATH GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_COUNT GIT_DIR GIT_WORK_TREE \
      DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME \
      SSL_CERT_FILE SSL_CERT_DIR GITHUB_TOKEN GH_TOKEN
    export HOME=/root
    verify_installed_implementation
    ;;
esac

# Both lanes serialize against the same lock. Root lane-state changes must take
# this lock before replacing RELEASE_LANE_STATE.
require_secure_root_ancestors "$ARTIFACT_STATE/.transaction.lock"
if [ -e "$TRANSACTION_ROOT" ] || [ -L "$TRANSACTION_ROOT" ]; then
  require_secure_root_ancestors "$TRANSACTION_ROOT/.probe"
fi
install -d -o root -g root -m 0700 "$ARTIFACT_STATE" "$TRANSACTION_ROOT"
exec 9>"$ARTIFACT_STATE/.transaction.lock"
flock -x 9

case "$command" in
  health) [ "$#" -eq 1 ] || usage; health "$@" ;;
  boundary) [ "$#" -eq 0 ] || usage; boundary ;;
  artifact-prepare) [ "$#" -eq 8 ] || usage; artifact_prepare "$@" ;;
  artifact-preflight) [ "$#" -eq 2 ] || usage; artifact_preflight "$@" ;;
  artifact-migrate) [ "$#" -eq 1 ] || usage; artifact_migrate "$@" ;;
  artifact-replace) [ "$#" -eq 1 ] || usage; artifact_replace "$@" ;;
  artifact-status) [ "$#" -eq 2 ] || usage; artifact_status "$@" ;;
  artifact-rollback) [ "$#" -eq 1 ] || usage; artifact_rollback "$@" ;;
  *) usage ;;
esac
