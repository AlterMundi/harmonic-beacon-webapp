}

verify_migration_recovery_targets() {
  local run_id="$1" transaction prior_app prior_worker ref
  transaction="$(artifact_transaction "$run_id")"
  prior_app="$(jq -er '.app.imageRef' "$transaction/prior/service-releases.json")"
  prior_worker="$(jq -er '."commerce-reconciler".imageRef' "$transaction/prior/service-releases.json")"
  for ref in "$prior_app" "$prior_worker"; do
    verify_pulled_image "$ref"
    docker run --rm --entrypoint test "$ref" -f /app/src/lib/stage-grant-effects.ts ||
      die 'migration preflight refused: prior app/worker lacks durable grant compatibility'
    docker run --rm --entrypoint test "$ref" -f /app/scripts/stage-grant-rollback-preflight.ts ||
      die 'migration preflight refused: prior app/worker lacks rollback compatibility'
  done
}

build_next_service_releases() {
  local root="$1" source_sha="$2" run_id="$3" service ref temporary
  cp -- "$root/prior/service-releases.json" "$root/next-service-releases.json"
  while IFS= read -r service; do
    if jq -e --arg service "$service" '.deployment.reusePriorImages | index($service)' "$root/impact-plan.json" >/dev/null; then
      ref="$(jq -er --arg service "$service" '.[$service].imageRef' "$root/prior/service-releases.json")"
    else
      ref="$(manifest_ref "$root/candidate/candidate-manifest.json" artifacts "$(case "$service" in app|commerce-reconciler) printf app;; *) printf '%s' "$service";; esac)")"
    fi
    temporary="$root/next-service-releases.json.new"
    jq --arg service "$service" --arg sourceSha "$source_sha" --arg imageRef "$ref"       '.[$service]={sourceSha:$sourceSha,imageRef:$imageRef}' "$root/next-service-releases.json" > "$temporary"
    mv -f -- "$temporary" "$root/next-service-releases.json"
  done < <(jq -r '.deployment.servicesToReplace[]' "$root/impact-plan.json")
  chown root:root "$root/next-service-releases.json"
  chmod 0600 "$root/next-service-releases.json"
}

