#!/usr/bin/env bash

# Root-owned deployment entrypoint for the dedicated mona Actions runner.
# The runner may invoke this file through sudo, but cannot invoke Docker or an
# arbitrary root shell directly. Keep every accepted argument fail-closed.

set -euo pipefail

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

readonly PRODUCTION_ENV='/etc/harmonic-beacon/production.env'
readonly COMMERCE_ENV='/etc/harmonic-beacon/commerce.env'
readonly ACCOUNT_ENV='/etc/harmonic-beacon/live-production-secrets/account.env'
readonly WORKSPACE='/opt/actions-runner/_work/harmonic-beacon-webapp/harmonic-beacon-webapp'
readonly PRIVATE_NETWORK='pmp_beacon_internal'
readonly EXPECTED_NETWORK_MEMBERS=$'beacon-app\npmp-myth-worker\npmp-myth-worker-secondary'
readonly ARTIFACT_VERIFY='/usr/local/libexec/harmonic-beacon/hb-artifact-verify'
readonly ARTIFACT_STATE='/var/lib/harmonic-beacon/releases'
readonly OCI_OVERLAY='deploy/oci-images.compose.yml'
readonly REGISTRY_ENV='/etc/harmonic-beacon/registry.env'

die() {
  printf 'hb-deploy: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [ "${EUID}" -eq 0 ] || die 'must run as root through the restricted sudo rule'
}

validate_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die 'invalid commit SHA'
}

validate_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || die 'invalid SHA-256'
}

validate_digest() {
  [[ "$1" =~ ^sha256:[0-9a-f]{64}$ ]] || die 'invalid digest'
}

validate_image_ref() {
  [[ "$1" =~ ^[a-z0-9./-]+@sha256:[0-9a-f]{64}$ ]] || die 'invalid exact image reference'
}

validate_target() {
  [ "$1" = shadow ] || [ "$1" = production ] || die 'invalid artifact target'
}

validate_run_id() {
  [[ "$1" =~ ^[1-9][0-9]{0,19}$ ]] || die 'invalid Actions run id'
}

validate_build_time() {
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
    die 'invalid UTC build time'
}

validate_schema_version() {
  [[ "$1" =~ ^[0-9]{14}_[a-z0-9_]+$ ]] || die 'invalid database schema version'
}

validate_boolean() {
  [ "$1" = true ] || [ "$1" = false ] || die 'invalid boolean'
}

validate_workspace() {
  [ "$1" = "$WORKSPACE" ] || die 'unexpected Actions workspace'
  [ "$(realpath -e -- "$1")" = "$WORKSPACE" ] || die 'workspace must not redirect elsewhere'
  [ -f "$WORKSPACE/docker-compose.yml" ] || die 'compose manifest is missing'
}

validate_checkout() {
  local expected_sha="$1"
  local actual_sha

  validate_sha "$expected_sha"
  actual_sha="$(git -c safe.directory="$WORKSPACE" -C "$WORKSPACE" rev-parse HEAD)"
  [ "$actual_sha" = "$expected_sha" ] || die 'workspace revision does not match requested release'
  git -c safe.directory="$WORKSPACE" -C "$WORKSPACE" diff --quiet -- ||
    die 'workspace has tracked changes'
  git -c safe.directory="$WORKSPACE" -C "$WORKSPACE" diff --cached --quiet -- ||
    die 'workspace index has tracked changes'
}

validate_container() {
  case "$1" in
    beacon-app | beacon-commerce-reconciler | beacon-tapestry) ;;
    *) die 'container is not in the deploy health allowlist' ;;
  esac
}

compose() {
  local workspace="$1"
  local image_tag="$2"
  shift 2

  (
    cd "$workspace"
    BEACON_IMAGE_TAG="$image_tag" docker compose --file "$workspace/docker-compose.yml" \
      --project-name app --env-file "$PRODUCTION_ENV" "$@"
  )
}

network_members() {
  docker network inspect "$PRIVATE_NETWORK" \
    --format '{{range .Containers}}{{println .Name}}{{end}}' |
    sed '/^[[:space:]]*$/d' |
    sort
}

require_exact_private_network() {
  local members

  [ "$(docker network inspect "$PRIVATE_NETWORK" --format '{{.Internal}}')" = true ] ||
    die 'commerce network is not internal'
  members="$(network_members)"
  if [ "$members" != "$EXPECTED_NETWORK_MEMBERS" ]; then
    printf 'Unexpected %s members:\n%s\n' "$PRIVATE_NETWORK" "$members" >&2
    exit 1
  fi
}

container_has_env_name() {
  docker inspect "$1" \
    --format '{{range .Config.Env}}{{println .}}{{end}}' |
    cut -d= -f1 |
    grep -Fxq "$2"
}

container_has_commerce_key() {
  docker inspect "$1" \
    --format '{{range .Config.Env}}{{println .}}{{end}}' |
    cut -d= -f1 |
    grep -Eq '^BEACON_COMMERCE_SERVICE_KEY_'
}

preflight() {
  local workspace="$1"
  local sha="$2"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  [ -r "$PRODUCTION_ENV" ] || die 'production environment is not readable by root'
  [ -r "$COMMERCE_ENV" ] || die 'commerce environment is not readable by root'
  [ "$(stat -c '%a:%U:%G' "$COMMERCE_ENV")" = '600:root:root' ] ||
    die 'commerce environment permissions are not 600:root:root'
  if [ -e "$ACCOUNT_ENV" ]; then
    [ -f "$ACCOUNT_ENV" ] && [ ! -L "$ACCOUNT_ENV" ] ||
      die 'Account environment must be a regular file'
    [ "$(stat -c '%a:%U:%G' "$ACCOUNT_ENV")" = '600:root:root' ] ||
      die 'Account environment permissions are not 600:root:root'
    container_has_env_name beacon-app BEACON_ACCOUNT_ENABLED &&
      [ "$(docker inspect beacon-app --format '{{range .Config.Env}}{{println .}}{{end}}' |
        sed -n 's/^BEACON_ACCOUNT_ENABLED=//p' | tail -n 1)" = true ] ||
      die 'Account bundle exists before the supervised Account activation'
  fi
  if grep -Fxq 'E2E_DASHBOARD_ENABLED=1' "$PRODUCTION_ENV"; then
    die 'production E2E dashboard must be disabled before deploy'
  fi
  require_exact_private_network
  compose "$workspace" "$sha" config --quiet
}

preserve() {
  local run_id="$1"
  local previous_app
  local previous_tapestry

  validate_run_id "$run_id"
  previous_app="$(docker inspect beacon-app --format '{{.Image}}' 2>/dev/null || true)"
  if [ -n "$previous_app" ]; then
    docker tag "$previous_app" "harmonic-beacon/app:rollback-${run_id}"
    printf 'app_available=true\n'
  else
    printf 'app_available=false\n'
  fi

  previous_tapestry="$(docker inspect beacon-tapestry --format '{{.Image}}' 2>/dev/null || true)"
  if [ -n "$previous_tapestry" ]; then
    docker tag "$previous_tapestry" "harmonic-beacon/tapestry:rollback-${run_id}"
    printf 'tapestry_available=true\n'
  else
    printf 'tapestry_available=false\n'
  fi
}

build() {
  local workspace="$1"
  local sha="$2"
  local build_time="$3"
  local schema_version="$4"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  validate_build_time "$build_time"
  validate_schema_version "$schema_version"
  (
    cd "$workspace"
    BEACON_IMAGE_TAG="$sha" \
      BEACON_GIT_SHA="$sha" \
      BEACON_BUILD_TIME="$build_time" \
      BEACON_DATABASE_SCHEMA_VERSION="$schema_version" \
      docker compose --file "$workspace/docker-compose.yml" \
      --project-name app --env-file "$PRODUCTION_ENV" \
      build app tapestry
  )
}

migrate() {
  local workspace="$1"
  local sha="$2"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  compose "$workspace" "$sha" run --rm --no-deps migrate npx prisma migrate deploy
  compose "$workspace" "$sha" run --rm --no-deps migrate \
    npx tsx scripts/stage-grant-forward-drain.ts
  compose "$workspace" "$sha" run --rm --no-deps migrate npx prisma migrate status
}

quiesce() {
  local workspace="$1"
  local sha="$2"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  compose "$workspace" "$sha" run --rm --no-deps migrate \
    npx tsx scripts/release-quiesce-preflight.ts
  compose "$workspace" "$sha" stop app
  # Close the check/use race: no request-serving writer exists during this
  # second check, and migration begins only after it remains clean.
  compose "$workspace" "$sha" run --rm --no-deps migrate \
    npx tsx scripts/release-quiesce-preflight.ts
}

replace() {
  local workspace="$1"
  local sha="$2"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  compose "$workspace" "$sha" up -d --no-deps --force-recreate \
    app commerce-reconciler tapestry
}

health() {
  validate_container "$1"
  docker inspect "$1" --format '{{.State.Health.Status}}'
}

status() {
  local workspace="$1"
  local sha="$2"

  validate_workspace "$workspace"
  validate_checkout "$sha"
  compose "$workspace" "$sha" ps
  for container in beacon-app beacon-commerce-reconciler beacon-tapestry; do
    docker inspect "$container" \
      --format 'name={{.Name}} status={{.State.Status}} health={{.State.Health.Status}} restarts={{.RestartCount}}'
  done
}

boundary() {
  require_exact_private_network
  container_has_env_name beacon-app BEACON_COMMERCE_SERVICE_KEY_CURRENT_ID ||
    die 'app is missing commerce key id'
  container_has_env_name beacon-app BEACON_COMMERCE_SERVICE_KEY_CURRENT ||
    die 'app is missing commerce key'

  for container in beacon-postgres beacon-livekit beacon-playlist-bot \
    beacon-tapestry beacon-commerce-reconciler pmp-myth-api \
    pmp-myth-worker pmp-myth-worker-secondary pmp-myth-postgres \
    pmp-myth-waha pmp-myth-rag pmp-myth-gateway; do
    if docker inspect "$container" >/dev/null 2>&1 && container_has_commerce_key "$container"; then
      die "commerce bearer reached unexpected container: $container"
    fi
  done

  if [ -e "$ACCOUNT_ENV" ]; then
    [ "$(docker inspect beacon-app --format '{{range .Config.Env}}{{println .}}{{end}}' |
      sed -n 's/^BEACON_ACCOUNT_ENABLED=//p' | tail -n 1)" = true ] ||
      die 'app has Account secrets but Account is not enabled'
    container_has_env_name beacon-app BEACON_ACCOUNT_CLIENT_SECRET ||
      die 'app is missing the Account client secret'
  elif container_has_env_name beacon-app BEACON_ACCOUNT_CLIENT_SECRET; then
    die 'app received Account secrets without the root-owned bundle'
  fi
  for container in beacon-postgres beacon-livekit beacon-playlist-bot \
    beacon-tapestry beacon-commerce-reconciler; do
    if container_has_env_name "$container" BEACON_ACCOUNT_CLIENT_SECRET; then
      die "Account RP secret reached unexpected container: $container"
    fi
  done
}

rollback() {
  local workspace="$1"
  local run_id="$2"
  local app_available="$3"
  local tapestry_available="$4"
  local migration_attempted="$5"
  local rollback_tag
  local candidate_tag
  local worker_expected=false

  validate_workspace "$workspace"
  validate_run_id "$run_id"
  validate_boolean "$app_available"
  validate_boolean "$tapestry_available"
  validate_boolean "$migration_attempted"
  rollback_tag="rollback-${run_id}"
  candidate_tag="$(git -c safe.directory="$workspace" -C "$workspace" rev-parse HEAD)"
  validate_checkout "$candidate_tag"

  if [ "$app_available" = true ] && [ "$migration_attempted" = true ]; then
    # Stop request-serving writers first. Keep the compatible candidate worker
    # alive briefly so already-committed effects can converge, then freeze it
    # and repeat the preflight against a stable database snapshot.
    compose "$workspace" "$candidate_tag" stop app
    preflight_ready=false
    for _attempt in $(seq 1 30); do
      if compose "$workspace" "$candidate_tag" run --rm --no-deps migrate \
        npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null; then
        preflight_ready=true
        break
      fi
      sleep 2
    done
    [ "$preflight_ready" = true ] || {
      docker stop beacon-commerce-reconciler 2>/dev/null || true
      die 'automatic rollback refused: durable grant state did not quiesce'
    }
    docker stop beacon-commerce-reconciler 2>/dev/null || true
    compose "$workspace" "$candidate_tag" run --rm --no-deps migrate \
      npx tsx scripts/stage-grant-rollback-preflight.ts >/dev/null ||
      die 'automatic rollback refused: stable grant preflight failed'

    # Never put an outbox-unaware application back in front of the migrated
    # database. A failed first rollout remains isolated for human forward
    # repair instead of silently reopening legacy grant writers.
    docker run --rm --entrypoint test \
      "harmonic-beacon/app:${rollback_tag}" \
      -f /app/src/lib/stage-grant-effects.ts ||
      die 'automatic rollback refused: previous app lacks durable grant contract'
    docker run --rm --entrypoint test \
      "harmonic-beacon/app:${rollback_tag}" \
      -f /app/scripts/stage-grant-rollback-preflight.ts ||
      die 'automatic rollback refused: previous worker lacks rollback preflight'

    compose "$workspace" "$rollback_tag" up -d --no-deps --force-recreate \
      app commerce-reconciler
    worker_expected=true
  elif [ "$app_available" = true ]; then
    # Build/gate/quiesce failures before a migration attempt never changed the
    # durable schema. Ensure the preserved application is serving again.
    compose "$workspace" "$rollback_tag" up -d --no-deps --force-recreate app
    worker_expected=true
  fi

  if [ "$tapestry_available" = true ]; then
    compose "$workspace" "$rollback_tag" up -d --no-deps --force-recreate tapestry
  fi

  for _attempt in $(seq 1 60); do
    local app_ready=true
    local worker_ready=true
    local tapestry_ready=true
    if [ "$app_available" = true ]; then
      if [ "$(health beacon-app 2>/dev/null || true)" != healthy ] || \
        ! curl --fail --silent --show-error http://127.0.0.1:3000/api/health/ready >/dev/null; then
        app_ready=false
      fi
    fi
    if [ "$worker_expected" = true ] && \
      [ "$(health beacon-commerce-reconciler 2>/dev/null || true)" != healthy ]; then
      worker_ready=false
    fi
    if [ "$tapestry_available" = true ] && \
      [ "$(health beacon-tapestry 2>/dev/null || true)" != healthy ]; then
      tapestry_ready=false
    fi
    if [ "$app_ready" = true ] && [ "$worker_ready" = true ] && \
      [ "$tapestry_ready" = true ]; then
      return 0
    fi
    sleep 2
  done

  compose "$workspace" "$rollback_tag" ps
  die 'rollback services did not become ready'
}

artifact_receipt() {
  printf '%s/candidate-%s.json\n' "$ARTIFACT_STATE" "$1"
}

artifact_ref() {
  local run_id="$1"
  local section="$2"
  local key="$3"
  local value
  value="$(jq -er --arg key "$key" ".${section}[\$key]" "$(artifact_receipt "$run_id")")" ||
    die "prepared artifact receipt is missing ${section}.${key}"
  validate_image_ref "$value"
  printf '%s\n' "$value"
}

artifact_compose() {
  local workspace="$1"
  local run_id="$2"
  shift 2
  local app tapestry playlist analytics postgres livekit config_sha
  app="$(artifact_ref "$run_id" imageRefs app)"
  tapestry="$(artifact_ref "$run_id" imageRefs tapestry)"
  playlist="$(artifact_ref "$run_id" imageRefs playlist-bot)"
  analytics="$(artifact_ref "$run_id" imageRefs analytics)"
  postgres="$(artifact_ref "$run_id" externalRefs postgres)"
  livekit="$(artifact_ref "$run_id" externalRefs livekit)"
  config_sha="$(jq -er '.targetConfigSha256' "$(artifact_receipt "$run_id")")"
  validate_digest "$config_sha"
  (
    cd "$workspace"
    HB_APP_IMAGE_REF="$app" HB_TAPESTRY_IMAGE_REF="$tapestry" \
      HB_PLAYLIST_IMAGE_REF="$playlist" HB_ANALYTICS_IMAGE_REF="$analytics" \
      HB_POSTGRES_IMAGE_REF="$postgres" HB_LIVEKIT_IMAGE_REF="$livekit" \
      HB_CONFIG_PROFILE_SHA256="$config_sha" \
      docker compose --file "$workspace/docker-compose.yml" \
      --file "$workspace/$OCI_OVERLAY" --project-name app \
      --env-file "$PRODUCTION_ENV" "$@"
  )
}

artifact_prepare() {
  local workspace="$1" sha="$2" tree="$3" run_id="$4"
  local manifest_sha="$5" target="$6" config_sha="$7"
  local input_root manifest evidence verified verified_dir docker_config
  validate_workspace "$workspace"
  validate_checkout "$sha"
  validate_sha "$tree"
  [ "$(git -c safe.directory="$workspace" -C "$workspace" rev-parse 'HEAD^{tree}')" = "$tree" ] ||
    die 'workspace tree does not match candidate source tree'
  validate_run_id "$run_id"
  validate_sha256 "$manifest_sha"
  validate_target "$target"
  validate_digest "$config_sha"
  [ -x "$ARTIFACT_VERIFY" ] || die 'root-owned artifact verifier is not installed'
  [ "$(stat -c '%U:%G:%a' "$ARTIFACT_VERIFY")" = 'root:root:755' ] ||
    die 'artifact verifier ownership or mode is invalid'
  [ -r "$REGISTRY_ENV" ] || die 'root-owned registry credentials are unavailable'
  [ "$(stat -c '%U:%G:%a' "$REGISTRY_ENV")" = 'root:root:600' ] ||
    die 'registry credential ownership or mode is invalid'
  [ -r "$ARTIFACT_STATE/current-manifest.sha256" ] ||
    die 'current manifest digest is not initialized'
  install -d -o root -g root -m 0700 "$ARTIFACT_STATE"
  input_root="$workspace/.hb-artifacts/$run_id/candidate"
  manifest="$input_root/release-manifest.json"
  evidence="$input_root/evidence"
  [ -f "$manifest" ] && [ ! -L "$manifest" ] || die 'candidate manifest is missing or unsafe'
  [ -d "$evidence" ] && [ ! -L "$evidence" ] || die 'candidate evidence is missing or unsafe'
  verified_dir="$(mktemp -d --tmpdir="$ARTIFACT_STATE" '.verified.XXXXXX')"
  verified="$verified_dir/receipt.json"
  docker_config="$verified_dir/docker"
  install -d -o root -g root -m 0700 "$docker_config"
  export DOCKER_CONFIG="$docker_config"
  trap 'unset DOCKER_CONFIG; rm -rf -- "$verified_dir"' RETURN
  "$ARTIFACT_VERIFY" --manifest "$manifest" --evidence "$evidence" \
    --manifest-sha256 "$manifest_sha" --source-sha "$sha" --source-tree "$tree" \
    --target "$target" --config-sha256 "$config_sha" \
    --current-base-file "$ARTIFACT_STATE/current-manifest.sha256" --output "$verified"
  jq -e . "$verified" >/dev/null || die 'artifact verifier emitted invalid receipt'
  jq --arg target "$target" --arg config "$config_sha" \
    '. + {target:$target,targetConfigSha256:$config}' "$verified" > "${verified}.bound"
  mv -- "${verified}.bound" "$verified"
  chmod 0600 "$verified"

  # The credential file is root-only and is never exposed to candidate code.
  # shellcheck disable=SC1090
  source "$REGISTRY_ENV"
  [ -n "${HB_REGISTRY_USERNAME:-}" ] && [ -n "${HB_REGISTRY_TOKEN:-}" ] ||
    die 'registry credentials are incomplete'
  printf '%s' "$HB_REGISTRY_TOKEN" | docker login ghcr.io --username "$HB_REGISTRY_USERNAME" --password-stdin >/dev/null
  while IFS= read -r ref; do
    validate_image_ref "$ref"
    docker pull "$ref" >/dev/null
  done < <(jq -r '.imageRefs[],.rollbackRefs[],.externalRefs[]' "$verified")
  while IFS= read -r ref; do
    cosign verify --certificate-oidc-issuer=https://token.actions.githubusercontent.com \
      --certificate-identity='https://github.com/AlterMundi/harmonic-beacon-webapp/.github/workflows/oci-candidate.yml@refs/heads/main' \
      "$ref" >/dev/null
    docker buildx imagetools inspect --format '{{ json .SBOM }}' "$ref" | jq -e . >/dev/null
    docker buildx imagetools inspect --format '{{ json .Provenance }}' "$ref" | jq -e . >/dev/null
  done < <(jq -r '.imageRefs[],.rollbackRefs[]' "$verified")
  unset HB_REGISTRY_TOKEN HB_REGISTRY_USERNAME
  install -o root -g root -m 0600 "$verified" "$(artifact_receipt "$run_id")"
  install -o root -g root -m 0600 "$manifest" "$ARTIFACT_STATE/candidate-${run_id}.manifest.json"
}

artifact_preflight() {
  local workspace="$1" sha="$2" run_id="$3" target="$4"
  validate_workspace "$workspace"
  validate_checkout "$sha"
  validate_run_id "$run_id"
  validate_target "$target"
  [ -r "$(artifact_receipt "$run_id")" ] || die 'artifact set was not prepared'
  if [ "$target" = production ]; then
    [ -r "$PRODUCTION_ENV" ] || die 'production environment is not readable by root'
    [ -r "$COMMERCE_ENV" ] || die 'commerce environment is not readable by root'
    require_exact_private_network
    artifact_compose "$workspace" "$run_id" config --quiet
  fi
}

artifact_migrate() {
  local workspace="$1" run_id="$2"
  validate_workspace "$workspace"
  validate_run_id "$run_id"
  artifact_compose "$workspace" "$run_id" run --rm --no-deps --no-build --pull never \
    migrate npx prisma migrate deploy
  artifact_compose "$workspace" "$run_id" run --rm --no-deps --no-build --pull never \
    migrate npx tsx scripts/stage-grant-forward-drain.ts
  artifact_compose "$workspace" "$run_id" run --rm --no-deps --no-build --pull never \
    migrate npx prisma migrate status
}

artifact_replace() {
  local workspace="$1" run_id="$2"
  validate_workspace "$workspace"
  validate_run_id "$run_id"
  artifact_compose "$workspace" "$run_id" up -d --no-deps --force-recreate \
    --no-build --pull never app commerce-reconciler tapestry playlist-bot
}

artifact_status() {
  local workspace="$1" run_id="$2" target="$3"
  validate_workspace "$workspace"
  validate_run_id "$run_id"
  validate_target "$target"
  if [ "$target" = shadow ]; then
    jq -r '.imageRefs | to_entries[] | "artifact=\(.key) ref=\(.value)"' "$(artifact_receipt "$run_id")"
    return 0
  fi
  artifact_compose "$workspace" "$run_id" ps
  local container key expected actual
  while read -r container key; do
    expected="$(artifact_ref "$run_id" imageRefs "$key")"
    actual="$(docker inspect "$container" --format '{{.Config.Image}}')"
    [ "$actual" = "$expected" ] || die "$container is not running the qualified digest"
  done <<'EOF'
beacon-app app
beacon-commerce-reconciler app
beacon-tapestry tapestry
beacon-playlist-bot playlist-bot
EOF
  install -o root -g root -m 0600 "$ARTIFACT_STATE/candidate-${run_id}.manifest.json" \
    "$ARTIFACT_STATE/current-manifest.json"
  jq -er '.manifestSha256' "$(artifact_receipt "$run_id")" > "$ARTIFACT_STATE/current-manifest.sha256"
  chmod 0600 "$ARTIFACT_STATE/current-manifest.sha256"
}

artifact_rollback() {
  local workspace="$1" run_id="$2"
  local app tapestry playlist analytics postgres livekit config_sha rollback_sha
  validate_workspace "$workspace"
  validate_run_id "$run_id"
  app="$(artifact_ref "$run_id" rollbackRefs app)"
  tapestry="$(artifact_ref "$run_id" rollbackRefs tapestry)"
  playlist="$(artifact_ref "$run_id" rollbackRefs playlist-bot)"
  analytics="$(artifact_ref "$run_id" rollbackRefs analytics)"
  postgres="$(artifact_ref "$run_id" externalRefs postgres)"
  livekit="$(artifact_ref "$run_id" externalRefs livekit)"
  config_sha="$(jq -er '.targetConfigSha256' "$(artifact_receipt "$run_id")")"
  rollback_sha="$(jq -er '.rollbackManifestSha256' "$(artifact_receipt "$run_id")")"
  validate_digest "$config_sha"
  validate_sha256 "$rollback_sha"
  (
    cd "$workspace"
    HB_APP_IMAGE_REF="$app" HB_TAPESTRY_IMAGE_REF="$tapestry" \
      HB_PLAYLIST_IMAGE_REF="$playlist" HB_ANALYTICS_IMAGE_REF="$analytics" \
      HB_POSTGRES_IMAGE_REF="$postgres" HB_LIVEKIT_IMAGE_REF="$livekit" \
      HB_CONFIG_PROFILE_SHA256="$config_sha" \
      docker compose --file "$workspace/docker-compose.yml" --file "$workspace/$OCI_OVERLAY" \
      --project-name app --env-file "$PRODUCTION_ENV" up -d --no-deps --force-recreate \
      --no-build --pull never app commerce-reconciler tapestry playlist-bot
  )
  printf '%s\n' "$rollback_sha" > "$ARTIFACT_STATE/current-manifest.sha256"
  chmod 0600 "$ARTIFACT_STATE/current-manifest.sha256"
}

usage() {
  printf '%s\n' 'usage: hb-deploy {preflight|preserve|build|quiesce|migrate|replace|health|status|boundary|rollback|artifact-prepare|artifact-preflight|artifact-migrate|artifact-replace|artifact-status|artifact-rollback} ...' >&2
  exit 2
}

require_root
[ "$#" -gt 0 ] || usage
command="$1"
shift

case "$command" in
  preflight) [ "$#" -eq 2 ] || usage; preflight "$@" ;;
  preserve) [ "$#" -eq 1 ] || usage; preserve "$@" ;;
  build) [ "$#" -eq 4 ] || usage; build "$@" ;;
  quiesce) [ "$#" -eq 2 ] || usage; quiesce "$@" ;;
  migrate) [ "$#" -eq 2 ] || usage; migrate "$@" ;;
  replace) [ "$#" -eq 2 ] || usage; replace "$@" ;;
  health) [ "$#" -eq 1 ] || usage; health "$@" ;;
  status) [ "$#" -eq 2 ] || usage; status "$@" ;;
  boundary) [ "$#" -eq 0 ] || usage; boundary ;;
  rollback) [ "$#" -eq 5 ] || usage; rollback "$@" ;;
  artifact-prepare) [ "$#" -eq 7 ] || usage; artifact_prepare "$@" ;;
  artifact-preflight) [ "$#" -eq 4 ] || usage; artifact_preflight "$@" ;;
  artifact-migrate) [ "$#" -eq 2 ] || usage; artifact_migrate "$@" ;;
  artifact-replace) [ "$#" -eq 2 ] || usage; artifact_replace "$@" ;;
  artifact-status) [ "$#" -eq 3 ] || usage; artifact_status "$@" ;;
