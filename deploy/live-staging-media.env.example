# Install privately; never copy production media credentials.
LIVE_STAGING_MEDIA_API_KEY=staging-only-key
LIVE_STAGING_MEDIA_API_SECRET=<generate-at-least-32-random-characters>
LIVE_STAGING_TAPESTRY_SECRET=<generate-a-different-32-character-secret>
LIVE_STAGING_LIVEKIT_IMAGE=livekit/livekit-server@sha256:189f7c81b704a36642bc5c7e2d3e1ae83744627c11978a23a251bf19fbec64e0
LIVE_STAGING_TAPESTRY_IMAGE=sha256:<exact-image-id>
LIVE_STAGING_PLAYLIST_IMAGE=sha256:<exact-image-id>
# When rehearsing rollback to a legacy tapestry image, explicitly seed only the
# synthetic event IDs used by that drill; an empty list is valid for the new image.
LIVE_STAGING_TAPESTRY_SESSION_IDS=
