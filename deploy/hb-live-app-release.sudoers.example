# Root-owned mode0440. Add only appointed Unix operators to hb-live-operators.
# The existing root-owned permit remains the exact-image admission boundary.
Defaults!/usr/local/sbin/hb-live-app-release env_reset
Defaults!/usr/local/sbin/hb-live-app-release env_delete += "PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE LD_PRELOAD LD_LIBRARY_PATH"
%hb-live-operators ALL=(root) NOPASSWD: NOSETENV: /usr/local/sbin/hb-live-app-release staging prepare, \
    /usr/local/sbin/hb-live-app-release staging apply, \
    /usr/local/sbin/hb-live-app-release staging rollback, \
    /usr/local/sbin/hb-live-app-release staging recover, \
    /usr/local/sbin/hb-live-app-release staging status, \
    /usr/local/sbin/hb-live-app-release production prepare, \
    /usr/local/sbin/hb-live-app-release production apply, \
    /usr/local/sbin/hb-live-app-release production rollback, \
    /usr/local/sbin/hb-live-app-release production recover, \
    /usr/local/sbin/hb-live-app-release production status

# Only this fixed helper can build/admit qualified protected-release app sources.
Defaults!/usr/local/sbin/hb-live-candidate env_reset
Defaults!/usr/local/sbin/hb-live-candidate env_delete += "PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE LD_PRELOAD LD_LIBRARY_PATH HB_BUILD_LOCK_FD"
%hb-live-operators ALL=(root) NOPASSWD: NOSETENV: /usr/local/sbin/hb-live-candidate build *, \
    /usr/local/sbin/hb-live-candidate status *, \
    /usr/local/sbin/hb-live-candidate admit *, \
    /usr/local/sbin/hb-live-candidate readback *, \
    /usr/local/sbin/hb-live-candidate retire *
