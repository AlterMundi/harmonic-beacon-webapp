# Harmonic Beacon — production environment template
# Deploy to: /etc/harmonic-beacon/production.env  (mode 0600, never commit real values)
#
# This file documents every env var the beacon stack reads.
# Replace every <placeholder> with a real, strong random value before deploying.

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_USER=beacon
POSTGRES_PASSWORD=<generate: openssl rand -base64 24 | tr -d '=+/' | cut -c1-20>
POSTGRES_DB=beacon

# ── LiveKit ──────────────────────────────────────────────────────────
LIVEKIT_API_KEY=<generate: beacon$(openssl rand -hex 4)>
LIVEKIT_API_SECRET=<generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-40>
LIVEKIT_KEYS=<copy LIVEKIT_API_KEY>: <copy LIVEKIT_API_SECRET>
# Set this to the current API secret for the first rollout, then keep it stable
# across later LiveKit API credential rotations so participant identities do
# not change while old tokens are still connected.
LIVEKIT_IDENTITY_SECRET=<initially copy LIVEKIT_API_SECRET; rotate only with a room drain>

# ── Ticket admission ─────────────────────────────────────────────────
TICKET_CODE_PEPPER=<generate: openssl rand -base64 48 | tr -d '=+/' | cut -c1-64>
TICKET_CODE_DIGEST_VERSION=1

# Commerce bearer credentials deliberately live in the app-only file
# /etc/harmonic-beacon/commerce.env; see deploy/commerce.env.example. Never add
# them here because this shared file is also loaded by non-app containers.

# ── Staff credentials (seed-contract scrypt digests) ─────────────────
# Generate with: node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(16);const d=scryptSync('<password>',s,32);console.log('scrypt\$'+s.toString('base64url')+'\$'+d.toString('base64url'))"
STAFF_FACILITATOR_NAME=Julián
STAFF_FACILITATOR_EMAIL=<facilitator-email>
STAFF_FACILITATOR_PASSWORD_DIGEST=<scrypt$...>
# FACILITATOR_OP lets the assigned facilitator operate the same event cockpit.
STAFF_FACILITATOR_ROLE=FACILITATOR_OP
STAFF_OPERATOR_ONE_NAME=Operador 1
STAFF_OPERATOR_ONE_EMAIL=<operator-one-email>
STAFF_OPERATOR_ONE_PASSWORD_DIGEST=<scrypt$...>
STAFF_OPERATOR_TWO_NAME=Operador 2
STAFF_OPERATOR_TWO_EMAIL=<operator-two-email>
STAFF_OPERATOR_TWO_PASSWORD_DIGEST=<scrypt$...>
STAFF_ADMIN_NAME=Admin
STAFF_ADMIN_EMAIL=<admin-email>
STAFF_ADMIN_PASSWORD_DIGEST=<scrypt$...>

# ── Weekend events (Saturday 2026-08-01, Costa Rica UTC-6) ──────────
WEEKEND_SESSION_1_EVENT_JSON='{"id":"10000000-0000-4000-8000-000000000001","title":"Sesión Harmonic Beacon — Español","roomName":"weekend-session-1","scheduledAt":"2026-08-01T14:30:00.000Z"}'
WEEKEND_SESSION_2_EVENT_JSON='{"id":"10000000-0000-4000-8000-000000000002","title":"Harmonic Beacon Session — English","roomName":"weekend-session-2","scheduledAt":"2026-08-01T20:00:00.000Z"}'

# ── Session cookie ──────────────────────────────────────────────────
SESSION_COOKIE_TTL_SECONDS=604800

# ── Playlist bot ─────────────────────────────────────────────────────
LIVEKIT_ROOM_NAME=beacon

# ── Tapestry ─────────────────────────────────────────────────────────
TAPESTRY_INTERNAL_SECRET=<generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-40>
TAPESTRY_SESSION_IDS=<comma-separated UUIDs matching WEEKEND event IDs>
TAPESTRY_PORT=3100
# Server-side URL the app uses for the tapestry health probe (ops health).
TAPESTRY_INTERNAL_URL=http://tapestry:3100
# Leave false until thumbnail consent and the Cloudflare two-second cache rule
# are live. The staff health board remains available in either mode.
TAPESTRY_PUBLIC_ENABLED=false
# Build-time companion for the room UI. Set it to the same value when building
# the app image; public display stays hidden unless both switches are enabled.
NEXT_PUBLIC_TAPESTRY_PUBLIC_ENABLED=false

# ── Operator health (/api/ops/health) ────────────────────────────────
# Expected bed publisher identity in LIVEKIT_ROOM_NAME; must match the bot's.
BOT_IDENTITY=playlist-bot
# Per-subsystem probe bound in milliseconds (default 3000).
# OPS_HEALTH_TIMEOUT_MS=3000
