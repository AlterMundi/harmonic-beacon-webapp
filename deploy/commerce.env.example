# Harmonic Beacon private commerce API credentials
# Deploy to /etc/harmonic-beacon/commerce.env with mode 0600.
# This file is loaded only by beacon-app. Give the same current pair to the PMP
# worker through its own service-specific secret store; never to other Beacon
# containers.

BEACON_COMMERCE_SERVICE_KEY_CURRENT_ID=2026-08-v1
BEACON_COMMERCE_SERVICE_KEY_CURRENT=<generate at least 256 random bits>

# During a no-downtime rotation, add both previous values, move PMP to current,
# prove authenticated PUT and GET, then remove the previous pair.
# BEACON_COMMERCE_SERVICE_KEY_PREVIOUS_ID=2026-07-v1
# BEACON_COMMERCE_SERVICE_KEY_PREVIOUS=<previous bearer token>
