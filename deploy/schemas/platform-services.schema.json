{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmonicbeacon.com/schemas/platform-services.schema.json",
  "x-runtimeLimits": {
    "catalogBytes": 1048576,
    "services": 64,
    "endpointsPerService": 32,
    "environmentsPerService": 32,
    "requirementsPerService": 32,
    "aggregateChecks": 1024,
    "reportEntries": 2048
  },
  "type": "object",
  "required": ["schemaVersion", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"$ref": "#/$defs/safeString"},
    "schemaVersion": {"const": 2},
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "owner",
          "repository",
          "integrationLane",
          "deliveryLane",
          "ciWorkflow",
          "deployAdapter",
          "localPaths",
          "deployedRevision",
          "artifactFingerprint",
          "health",
          "alerts",
          "recovery",
          "staging",
          "unresolvedRequirements",
          "mutationPolicy"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"$ref": "#/$defs/safeNonemptyString"},
          "owner": {"$ref": "#/$defs/owner"},
          "repository": {"$ref": "#/$defs/repository"},
          "integrationLane": {"$ref": "#/$defs/lane"},
          "deliveryLane": {"$ref": "#/$defs/lane"},
          "ciWorkflow": {"$ref": "#/$defs/ciWorkflow"},
          "deployAdapter": {"$ref": "#/$defs/deployAdapter"},
          "localPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/repositoryPath"}
          },
          "workflows": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/repositoryPath"}
          },
          "branchSources": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/branchSource"}
          },
          "recoveryDocs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/repositoryPath"}
          },
          "deliveryPolicy": {"$ref": "#/$defs/deliveryPolicy"},
          "deployedRevision": {"$ref": "#/$defs/deployedRevision"},
          "artifactFingerprint": {"$ref": "#/$defs/artifactFingerprint"},
          "health": {"$ref": "#/$defs/health"},
          "alerts": {"$ref": "#/$defs/alerts"},
          "recovery": {"$ref": "#/$defs/recovery"},
          "staging": {"$ref": "#/$defs/staging"},
          "unresolvedRequirements": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/unresolvedRequirement"}
          },
          "runnerVerification": {"$ref": "#/$defs/runnerVerification"},
          "mutationPolicy": {"$ref": "#/$defs/safeNonemptyString"}
        }
      }
    }
  },
  "$defs": {
    "evidenceStatus": {
      "enum": ["verified", "documented", "unresolved", "external", "unavailable", "not-applicable"]
    },
    "safeString": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "safeNonemptyString": {
      "allOf": [
        {"$ref": "#/$defs/safeString"},
        {"minLength": 1}
      ]
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^(?!.*\\\\)(?!.*%(?![0-9A-F]{2}))(?!.*%(?:0[0-9A-F]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F]|2E|2F|5C|23|3F))(?!.*\\/\\.\\.?(?:\\/|[?#]|$))https:\\/\\/(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?!(?:(?:0x[0-9a-f]*|0[0-7]*|[1-9][0-9]*)\\.){0,3}(?:0x[0-9a-f]*|0[0-7]*|[1-9][0-9]*)(?:\\/|[?#]|$))(?=[a-z0-9.-]*[a-z])[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)(?:\\/[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\\\#]*)?(?:\\?[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\\\#]*)?$"
    },
    "httpsReference": {
      "type": "string",
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^(?!.*\\\\)(?!.*%(?![0-9A-F]{2}))(?!.*%(?:0[0-9A-F]|1[0-9A-F]|7F|8[0-9A-F]|9[0-9A-F]|2E|2F|5C|23|3F))(?!.*\\/\\.\\.?(?:\\/|[?#]|$))https:\\/\\/(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?!(?:(?:0x[0-9a-f]*|0[0-7]*|[1-9][0-9]*)\\.){0,3}(?:0x[0-9a-f]*|0[0-7]*|[1-9][0-9]*)(?:\\/|[?#]|$))(?=[a-z0-9.-]*[a-z])[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*)(?:\\/[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\\\#]*)?(?:\\?[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\\\#]*)?(?:#[^\\s\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069\\\\]*)?$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$"
    },
    "reference": {
      "oneOf": [
        {"$ref": "#/$defs/httpsReference"},
        {"$ref": "#/$defs/repositoryPath"}
      ]
    },
    "references": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    },
    "verifiedKindEvidence": {
      "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
      "then": {
        "properties": {"kind": {"not": {"const": "unknown"}}},
        "anyOf": [
          {"required": ["references"], "properties": {"references": {"type": "array", "minItems": 1}}},
          {"required": ["value"], "properties": {"value": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "owner": {
      "type": "object",
      "required": ["status", "name"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "name": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safeNonemptyString"}
          ]
        }
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "documented"]}}},
        "then": {"properties": {"name": {"$ref": "#/$defs/safeNonemptyString"}}}
      }]
    },
    "repository": {
      "type": "object",
      "required": ["status", "slug"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "slug": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "documented"]}}},
        "then": {"properties": {"slug": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}}}
      }]
    },
    "lane": {
      "type": "object",
      "required": ["status", "name"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "name": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "documented"]}}},
        "then": {"properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}}}
      }]
    },
    "ciWorkflow": {
      "type": "object",
      "required": ["status", "path"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "path": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repositoryPath"}
          ]
        }
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"enum": ["verified", "documented"]}}},
        "then": {"properties": {"path": {"$ref": "#/$defs/repositoryPath"}}}
      }]
    },
    "deployAdapter": {
      "type": "object",
      "required": ["status", "kind", "references"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "kind": {
          "enum": ["github-pages-branch", "github-actions-workflow", "repository-script", "compose-systemd", "unknown"]
        },
        "references": {"$ref": "#/$defs/references"}
      }
    ,
      "allOf": [{"$ref": "#/$defs/verifiedKindEvidence"}, {
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"references": {"type": "array", "minItems": 1}}}
      }]
    },
    "deployedRevision": {
      "type": "object",
      "required": ["status", "value"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"value": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
      }]
    },
    "artifactFingerprint": {
      "type": "object",
      "required": ["status", "kind", "value", "references"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "kind": {"enum": ["source-public-sha256", "oci-digest", "image-id-or-digest", "source-revision", "unknown"]},
        "value": {"type": ["string", "null"]},
        "references": {"$ref": "#/$defs/references"}
      },
      "allOf": [
        {"$ref": "#/$defs/verifiedKindEvidence"},
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {
            "properties": {
              "kind": {"enum": ["source-public-sha256", "oci-digest", "image-id-or-digest", "source-revision"]},
              "value": {"type": "string"},
              "references": {"type": "array", "minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "source-public-sha256"}}},
          "then": {"properties": {"value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["oci-digest", "image-id-or-digest"]}}},
          "then": {"properties": {"value": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "source-revision"}}},
          "then": {"properties": {"value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "unknown"}}},
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "healthEndpoint": {
      "type": "object",
      "required": ["name", "url", "expectStatus"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/safeNonemptyString"},
        "url": {"$ref": "#/$defs/httpsUrl"},
        "expectStatus": {
          "type": "array",
          "items": {"type": "integer", "minimum": 100, "maximum": 599},
          "minItems": 1,
          "uniqueItems": true
        },
        "provenanceField": {"$ref": "#/$defs/safeNonemptyString"}
      }
    },
    "health": {
      "type": "object",
      "required": ["status", "endpoints"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "endpoints": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/healthEndpoint"}
        }
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"endpoints": {"type": "array", "minItems": 1}}}
      }]
    },
    "alertRoute": {
      "type": "object",
      "required": ["status", "kind", "references"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "kind": {"enum": ["hosting-provider", "service-monitor", "alertmanager", "unknown"]},
        "references": {"$ref": "#/$defs/references"}
      }
    ,
      "allOf": [{"$ref": "#/$defs/verifiedKindEvidence"}, {
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"references": {"type": "array", "minItems": 1}}}
      }]
    },
    "outcomeEvidence": {
      "type": "object",
      "required": ["kind", "serviceId", "id", "result", "observedAt", "reference", "contentSha256"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["recipient-delivery", "recovery-exercise", "staging-drill"]},
        "serviceId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
        "result": {"const": "succeeded"},
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-9]))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
        },
        "reference": {"$ref": "#/$defs/reference"},
        "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "proof": {
      "type": "object",
      "required": ["status", "references", "outcome"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "references": {"$ref": "#/$defs/references"},
        "outcome": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/outcomeEvidence"}
          ]
        }
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {
          "properties": {
            "references": {"type": "array", "minItems": 1},
            "outcome": {"$ref": "#/$defs/outcomeEvidence"}
          }
        }
      }]
    },
    "recipientProof": {
      "allOf": [
        {"$ref": "#/$defs/proof"},
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"outcome": {"properties": {"kind": {"const": "recipient-delivery"}}}}}
        }
      ]
    },
    "recoveryProof": {
      "allOf": [
        {"$ref": "#/$defs/proof"},
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"outcome": {"properties": {"kind": {"const": "recovery-exercise"}}}}}
        }
      ]
    },
    "stagingDrillProof": {
      "allOf": [
        {"$ref": "#/$defs/proof"},
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"outcome": {"properties": {"kind": {"const": "staging-drill"}}}}}
        }
      ]
    },
    "alerts": {
      "type": "object",
      "required": ["route", "recipientProof"],
      "additionalProperties": false,
      "properties": {
        "route": {"$ref": "#/$defs/alertRoute"},
        "recipientProof": {"$ref": "#/$defs/recipientProof"}
      }
    },
    "recoveryTarget": {
      "type": "object",
      "required": ["status", "kind", "references"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "kind": {"enum": ["prior-git-revision", "prior-artifact", "restore-and-roll-forward", "forward-repair", "unknown"]},
        "references": {"$ref": "#/$defs/references"}
      }
    ,
      "allOf": [{"$ref": "#/$defs/verifiedKindEvidence"}, {
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"references": {"type": "array", "minItems": 1}}}
      }]
    },
    "recovery": {
      "type": "object",
      "required": ["target", "proof"],
      "additionalProperties": false,
      "properties": {
        "target": {"$ref": "#/$defs/recoveryTarget"},
        "proof": {"$ref": "#/$defs/recoveryProof"}
      }
    },
    "stagingEnvironment": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/safeNonemptyString"},
        "url": {"$ref": "#/$defs/httpsUrl"}
      }
    },
    "staging": {
      "type": "object",
      "required": ["status", "environments", "drill"],
      "additionalProperties": false,
      "properties": {
        "status": {"$ref": "#/$defs/evidenceStatus"},
        "environments": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stagingEnvironment"}
        },
        "drill": {"$ref": "#/$defs/stagingDrillProof"}
      }
    ,
      "allOf": [{
        "if": {"properties": {"status": {"const": "verified"}}},
        "then": {"properties": {"environments": {"type": "array", "minItems": 1}}}
      }]
    },
    "unresolvedRequirement": {
      "type": "object",
      "required": ["id", "kind", "status", "owner", "blocks", "reference"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "kind": {
          "enum": [
            "repository-access",
            "repository-identification",
            "workflow-authorization",
            "deploy-adapter",
            "deployment-revision",
            "artifact-fingerprint",
            "alert-route",
            "recipient-proof",
            "recovery-proof",
            "staging-environment",
            "staging-drill"
          ]
        },
        "status": {"enum": ["unresolved", "external"]},
        "owner": {"$ref": "#/$defs/safeNonemptyString"},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["catalog-readback", "delivery-proof", "alert-proof", "recovery-proof", "staging-proof"]}
        },
        "reference": {"$ref": "#/$defs/reference"}
      }
    },
    "branchSource": {
      "type": "object",
      "required": ["ref", "paths", "workflows", "recoveryDocs"],
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "pattern": "^(?!refs/pull/)[A-Za-z0-9._/-]+$"},
        "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}},
        "workflows": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}},
        "recoveryDocs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/repositoryPath"}}
      }
    },
    "deliveryPolicy": {
      "type": "object",
      "required": [
        "protectedBranches",
        "requiredContext",
        "requiredAppId",
        "requirePullRequest",
        "requireCodeOwnerReviews",
        "requiredApprovingReviewCount",
        "dismissStaleReviews",
        "requireLastPushApproval",
        "requireUpToDate",
        "allowForcePushes",
        "allowDeletions"
      ],
      "additionalProperties": false,
      "properties": {
        "protectedBranches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}},
        "requiredContext": {"$ref": "#/$defs/safeNonemptyString"},
        "requiredAppId": {"type": "integer", "minimum": 1},
        "requirePullRequest": {"const": true},
        "requireCodeOwnerReviews": {"const": true},
        "requiredApprovingReviewCount": {"type": "integer", "minimum": 1},
        "dismissStaleReviews": {"const": true},
        "requireLastPushApproval": {"const": true},
        "requireUpToDate": {"const": true},
        "allowForcePushes": {"const": false},
        "allowDeletions": {"const": false}
      }
    },
    "runnerVerification": {
      "type": "object",
      "required": ["organization", "groupId", "groupName", "repository", "workflow", "runnerName", "labels"],
      "additionalProperties": false,
      "properties": {
        "organization": {"$ref": "#/$defs/safeNonemptyString"},
        "groupId": {"type": "integer", "minimum": 1},
        "groupName": {"$ref": "#/$defs/safeNonemptyString"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflow": {"$ref": "#/$defs/safeNonemptyString"},
        "runnerName": {"$ref": "#/$defs/safeNonemptyString"},
        "labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safeNonemptyString"}}
      }
    }
  }
}
