{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmonicbeacon.com/schemas/platform-services.schema.json",
  "type": "object",
  "required": ["schemaVersion", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "lanes", "localPaths", "workflows", "health", "recoveryDocs", "alerts", "runner", "mutation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": ["string", "null"]},
          "lanes": {"type": "array", "items": {"type": "string"}},
          "localPaths": {"type": "array", "items": {"type": "string"}},
          "workflows": {"type": "array", "items": {"type": "string"}},
          "health": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "url", "expectStatus"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "expectStatus": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
                "provenanceField": {"type": "string"}
              }
            }
          },
          "staging": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "recoveryDocs": {"type": "array", "items": {"type": "string"}},
          "alerts": {"type": "string", "minLength": 1},
          "runner": {"type": "string", "minLength": 1},
          "runnerVerification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["organization", "groupId", "groupName", "repository", "workflow", "runnerName", "labels"],
            "properties": {
              "organization": {"type": "string"},
              "groupId": {"type": "integer"},
              "groupName": {"type": "string"},
              "repository": {"type": "string"},
              "workflow": {"type": "string"},
              "runnerName": {"type": "string"},
              "labels": {"type": "array", "items": {"type": "string"}}
            }
          },
          "mutation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
