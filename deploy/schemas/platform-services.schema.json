{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmonicbeacon.com/schemas/platform-services.schema.json",
  "type": "object",
  "required": ["schemaVersion", "services"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "authority", "lanes", "localPaths", "workflows", "branchSources", "health", "recoveryDocs", "alerts", "runner", "mutation"],
        "additionalProperties": false,
        "allOf": [
          {
            "anyOf": [
              {"properties": {"workflows": {"minItems": 1}}},
              {"properties": {"recoveryDocs": {"minItems": 1}}},
              {
                "properties": {
                  "branchSources": {
                    "contains": {
                      "anyOf": [
                        {"properties": {"workflows": {"minItems": 1}}},
                        {"properties": {"recoveryDocs": {"minItems": 1}}}
                      ]
                    }
                  }
                }
              }
            ]
          }
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "repository": {"type": ["string", "null"]},
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "detail"],
            "properties": {
              "status": {"enum": ["confirmed", "unresolved"]},
              "detail": {"type": "string", "minLength": 1}
            }
          },
          "lanes": {"type": "array", "items": {"type": "string"}},
          "localPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "workflows": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "branchSources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "paths", "workflows", "recoveryDocs"],
              "properties": {
                "ref": {"type": "string", "minLength": 1, "not": {"pattern": "^refs/pull/"}},
                "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "workflows": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "recoveryDocs": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "deliveryPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protectedBranches", "requiredContext", "requiredAppId", "requirePullRequest", "requireCodeOwnerReviews", "requiredApprovingReviewCount", "dismissStaleReviews", "requireLastPushApproval", "requireUpToDate", "allowForcePushes", "allowDeletions"],
            "properties": {
              "protectedBranches": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "requiredContext": {"type": "string", "minLength": 1},
              "requiredAppId": {"type": "integer", "minimum": 1},
              "requirePullRequest": {"const": true},
              "requireCodeOwnerReviews": {"const": true},
              "requiredApprovingReviewCount": {"type": "integer", "minimum": 1},
              "dismissStaleReviews": {"const": true},
              "requireLastPushApproval": {"const": true},
              "requireUpToDate": {"const": true},
              "allowForcePushes": {"const": false},
              "allowDeletions": {"const": false}
            }
          },
          "health": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "url", "expectStatus"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "expectStatus": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
                "provenanceField": {"type": "string"}
              }
            }
          },
          "staging": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "recoveryDocs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "alerts": {"type": "string", "minLength": 1},
          "runner": {"type": "string", "minLength": 1},
          "runnerVerification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["organization", "groupId", "groupName", "repository", "workflow", "runnerName", "labels"],
            "properties": {
              "organization": {"type": "string"},
              "groupId": {"type": "integer"},
              "groupName": {"type": "string"},
              "repository": {"type": "string"},
              "workflow": {"type": "string"},
              "runnerName": {"type": "string"},
              "labels": {"type": "array", "items": {"type": "string"}}
            }
          },
          "mutation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
