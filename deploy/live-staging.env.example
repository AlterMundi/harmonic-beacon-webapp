# Live staging only. Install as /etc/harmonic-beacon/live-staging.env,
# root:root mode 0600. Never reuse a production value.

POSTGRES_USER=beacon_staging
POSTGRES_PASSWORD=<generate-a-new-url-safe-secret>
POSTGRES_DB=beacon_live_staging
LIVE_STAGING_POSTGRES_DIR=/mnt/beacon-data/live-staging/postgres

# Synthetic-only ticket/session data. This must not match production.
TICKET_CODE_PEPPER=<generate-at-least-32-random-characters>
TICKET_CODE_DIGEST_VERSION=1
SESSION_COOKIE_TTL_SECONDS=86400
TRUSTED_PROXY_HOPS=1
PROMO_INVITATIONS_ENABLED=false

# The remote room/media path is intentionally absent from this staging slice.
# This public build value reserves the final URL without sharing production
# LiveKit credentials or media infrastructure.
NEXT_PUBLIC_LIVEKIT_URL=wss://live-staging.harmonicbeacon.com/rtc
LIVEKIT_ROOM_NAME=live-staging-unavailable

# Account remains dark until its dedicated secret file, public DNS/TLS edge,
# exact callbacks and the prepared/public preflights have all passed.
BEACON_ACCOUNT_ENABLED=false
BEACON_ACCOUNT_ISSUER_URL=https://account-staging.harmonicbeacon.com
BEACON_ACCOUNT_CLIENT_ID=hb-live-staging
# BEACON_ACCOUNT_CLIENT_SECRET lives only in the optional, root-owned
# /etc/harmonic-beacon/live-staging-secrets/account.env file.

TAPESTRY_PUBLIC_ENABLED=false
TAPESTRY_INTERNAL_URL=http://tapestry-unavailable.invalid
E2E_DASHBOARD_ENABLED=0
