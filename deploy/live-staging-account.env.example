# Live staging Account RP secret only. Install as
# /etc/harmonic-beacon/live-staging-secrets/account.env, root:root mode 0600;
# its parent directory is root:root mode 0700.
# Never reuse this file or value in production.

BEACON_ACCOUNT_CLIENT_SECRET=<copy-the-hb-live-staging-secret-with-the-root-owned-sync-command>
