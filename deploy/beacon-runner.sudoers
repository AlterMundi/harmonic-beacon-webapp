# Install as /etc/sudoers.d/harmonic-beacon-deploy (root:root 0440).
Defaults:beacon-runner !setenv
Defaults!/usr/local/sbin/hb-deploy env_reset
Defaults!/usr/local/sbin/hb-deploy env_delete += "BASH_ENV ENV NODE_OPTIONS NODE_PATH GIT_CONFIG_* GIT_DIR GIT_WORK_TREE DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG COMPOSE_FILE COMPOSE_PROFILES COMPOSE_PROJECT_NAME SSL_CERT_FILE SSL_CERT_DIR GITHUB_TOKEN GH_TOKEN"

Cmnd_Alias HARMONIC_BEACON_DEPLOY = /usr/local/sbin/hb-deploy *
beacon-runner ALL=(root) NOPASSWD:NOSETENV: HARMONIC_BEACON_DEPLOY
