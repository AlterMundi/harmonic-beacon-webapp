# Harmonic Beacon - Environment Variables
#
# For local development: copy to .env.local and fill in values
# For production: all secrets are stored in GitHub Secrets
#   and passed as env vars at deploy time (no .env files on server)
#
# Required GitHub Secrets:
#   DB_PASSWORD, TICKET_CODE_PEPPER, staff password digests,
#   LIVEKIT_API_KEY, LIVEKIT_API_SECRET, PUBLIC_IP,
#   NEXT_PUBLIC_LIVEKIT_URL

# ===================
# Database (host PostgreSQL)
# ===================
# Local dev: connect to local PG
DATABASE_URL="postgresql://beacon:your_password@localhost:5432/harmonic_beacon?schema=public"

# ===================
# LiveKit (beacon audio streaming)
# ===================
NEXT_PUBLIC_LIVEKIT_URL=wss://live.altermundi.net

# Server-side credentials for token generation API
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_NAME=beacon

# ===================
# Weekend authentication and seed contract
# ===================
# Generate independently with a cryptographically secure secret generator.
TICKET_CODE_PEPPER=replace-with-at-least-32-random-characters
# Fixed at seven days for the 2026-08-01/02 weekend plus support window.
SESSION_COOKIE_TTL_SECONDS=604800

# Trusted reverse-proxy hops in front of the app, used to find the real client
# address for the failed-login limiter. 1 = Nginx only; 2 = Cloudflare + Nginx.
# Too high a value keys the limiter on a forgeable header; too low keys every
# request into one shared bucket.
TRUSTED_PROXY_HOPS=1

# External ticketing platform purchase link. Unset until WS6-01 proves the
# payout rail; the landing page then says sales open shortly instead of linking.
TICKET_PURCHASE_URL=

# Password digests use: scrypt$<salt-base64url>$<digest-base64url>.
# These placeholders are deliberately invalid; supply unique production digests.
STAFF_FACILITATOR_NAME="Julian"
STAFF_FACILITATOR_EMAIL=facilitator@example.invalid
STAFF_FACILITATOR_PASSWORD_DIGEST=scrypt$replace_with_16_byte_salt$replace_with_32_byte_digest
STAFF_OPERATOR_ONE_NAME="Operator One"
STAFF_OPERATOR_ONE_EMAIL=operator-one@example.invalid
STAFF_OPERATOR_ONE_PASSWORD_DIGEST=scrypt$replace_with_16_byte_salt$replace_with_32_byte_digest
STAFF_OPERATOR_TWO_NAME="Operator Two"
STAFF_OPERATOR_TWO_EMAIL=operator-two@example.invalid
STAFF_OPERATOR_TWO_PASSWORD_DIGEST=scrypt$replace_with_16_byte_salt$replace_with_32_byte_digest
STAFF_ADMIN_NAME="Weekend Admin"
STAFF_ADMIN_EMAIL=admin@example.invalid
STAFF_ADMIN_PASSWORD_DIGEST=scrypt$replace_with_16_byte_salt$replace_with_32_byte_digest

# Event JSON supplies deployment-specific IDs, titles, room names, and times.
# Language/cap/publish limits are pinned by the seed and database schema.
WEEKEND_SATURDAY_EVENT_JSON='{"id":"10000000-0000-4000-8000-000000000001","title":"Saturday Harmonic Beacon","roomName":"weekend-saturday","scheduledAt":"2026-08-01T18:00:00.000Z"}'
WEEKEND_SUNDAY_EVENT_JSON='{"id":"10000000-0000-4000-8000-000000000002","title":"Sunday Harmonic Beacon","roomName":"weekend-sunday","scheduledAt":"2026-08-02T18:00:00.000Z"}'

# ===================
# File storage (bind-mounted from /mnt/n8n-data/harmonic-beacon/)
# ===================
MEDITATIONS_STORAGE_PATH=/data/meditations
UPLOADS_PATH=/data/uploads
RECORDINGS_PATH=/data/recordings
MAX_UPLOAD_SIZE_MB=100

# ===================
# Playlist Bot (auto-publishes recorded beacon audio when beacon01 is offline)
# ===================
# Identity shown in LiveKit room (frontend detects non-beacon01 as PLAYLIST mode)
BOT_IDENTITY=playlist-bot
# Path to recorded beacon .ogg files (bind-mounted in Docker)
BEACON_RECORDS_PATH=/data/beacon-records
