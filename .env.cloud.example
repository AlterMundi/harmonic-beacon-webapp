# Harmonic Beacon — Cloud deployment environment surface
#
# Target env for the cloud-native (Option B) deploy. See:
#   docs/CLOUD_MIGRATION_PLAN.md    — the plan
#   docs/CLOUD_MIGRATION_STATUS.md  — what is provisioned and verified
#
# This file documents the TARGET surface. It is not yet what the app reads —
# storage vars land with the Phase 1 driver, see plan §4.
#
# Secrets go in a secret store, never in a committed file. This is a template.

# =====================================================================
# Database — Neon (managed PostgreSQL 18)
# =====================================================================
# TWO connection strings, and the distinction is load-bearing:
#
#   DATABASE_URL  -> POOLED endpoint (-pooler host). App runtime.
#   DIRECT_URL    -> DIRECT endpoint (no -pooler). Migrations only.
#
# Prisma migrations need session-level features the transaction pooler does
# not provide. Both endpoints were verified working (STATUS doc); using the
# pooled one for migrations is the classic failure here.
#
# Cap connection_limit explicitly: N stateless replicas x Prisma's default
# pool will exhaust a small managed instance. The pooler helps, it does not
# make the limit infinite.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NOTE (pg 8.18+): `sslmode=require` now emits a deprecation warning — its
# meaning changes to verify-full in a future major. Decide explicitly rather
# than inheriting the default. See STATUS doc, "Findings not in the plan".

# =====================================================================
# Object storage — Cloudflare R2 (S3-compatible)
# =====================================================================
# Replaces all four bind-mounted directories from the compose deploy.
# R2's own endpoint is NOT behind the Cloudflare proxy, so presigned uploads
# are exempt from the 100MB free-plan body limit. That is precisely why
# uploads must go browser -> R2 directly and never through the app.
STORAGE_DRIVER=s3                     # "s3" | "local" (local = dev only)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto                        # R2 ignores region; SDK requires a value
S3_BUCKET=harmonic-beacon
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Presigned URL lifetimes (seconds).
# GET must comfortably exceed the longest meditation, or a URL expires
# mid-playback and seeking breaks. PUT only needs to cover an upload.
S3_SIGNED_GET_TTL=3600
S3_SIGNED_PUT_TTL=900

# Optional public/CDN base for cacheable audio delivery. Leave empty to serve
# via presigned GETs only.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Key prefixes — the layout that replaces the implicit status->directory
# coupling in the current code (plan §4.1)
STORAGE_PREFIX_UPLOADS=uploads
STORAGE_PREFIX_MEDITATIONS=meditations
STORAGE_PREFIX_RECORDINGS=recordings
STORAGE_PREFIX_BEACON_RECORDS=beacon-records

MAX_UPLOAD_SIZE_MB=100

# =====================================================================
# LiveKit Cloud — live beacon SFU + track egress
# =====================================================================
# The only component that genuinely needs WebRTC. go2rtc is deleted (D1):
# meditations are pre-recorded files served over HTTP Range instead.
NEXT_PUBLIC_LIVEKIT_URL=wss://harmonicbeacon-web-app-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_NAME=beacon

# Egress writes recordings straight to R2 instead of a shared local disk —
# this is what severs LiveKit's filesystem coupling to the app.
# Build tier includes only ~60 recording-minutes/month; overage is metered.
LIVEKIT_EGRESS_S3_BUCKET=harmonic-beacon
LIVEKIT_EGRESS_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LIVEKIT_EGRESS_S3_ACCESS_KEY_ID=
LIVEKIT_EGRESS_S3_SECRET_ACCESS_KEY=

# =====================================================================
# Auth — Zitadel OIDC (unchanged)
# =====================================================================
# AUTH_URL must be the PUBLIC origin. Behind a proxy, X-Forwarded-Proto has to
# arrive intact or NextAuth mints http:// callbacks and login silently breaks.
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_ZITADEL_ID=
AUTH_ZITADEL_ISSUER=https://auth.altermundi.net
AUTH_URL=https://beacon.altermundi.net
AUTH_TRUST_HOST=true

# =====================================================================
# Playlist bot
# =====================================================================
# Exactly ONE replica, always on. Two would double-publish audio.
# Not deployable to scale-to-zero platforms: it holds a persistent LiveKit
# socket, and request-billed compute throttles CPU between requests and kills
# it. This worker — not the web app — is what disqualifies most free tiers.
BOT_IDENTITY=playlist-bot
LIVEKIT_INTERNAL_URL=                 # empty => use NEXT_PUBLIC_LIVEKIT_URL

# =====================================================================
# Runtime / observability
# =====================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json                       # container platforms only read stdout

# =====================================================================
# Rate limiting (application-level)
# =====================================================================
# Cloudflare's Free plan allows ONE rate-limit rule with a 10-second window
# and no custom WAF rules, so the two limit_req_zone rules in
# deploy/nginx-harmonic-beacon.conf cannot be reproduced at the edge.
# They have to live in the app instead.
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_UPLOAD_PER_HOUR=20
