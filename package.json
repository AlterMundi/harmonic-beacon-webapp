{
  "name": "harmonic-beacon",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:test": "npx tsx prisma/seed-test-fixtures.ts",
    "db:fixture:load": "node scripts/load-test-fixture.mjs",
    "event:stabilize": "tsx scripts/weekend-stabilize.ts",
    "contract:commerce:verify": "python3 scripts/verify-commerce-contract.py",
    "contract:early-birds:verify": "python3 scripts/verify-early-bird-contracts.py",
    "commerce:reconcile": "tsx scripts/commerce-media-worker.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "load:livekit": "node scripts/livekit-load-harness.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "1.6.26",
    "dotenv": "^17.2.4",
    "hls.js": "1.6.17",
    "livekit-client": "^2.17.0",
    "livekit-server-sdk": "^2.15.0",
    "next": "16.2.12",
    "pg": "^8.18.0",
    "prisma": "^7.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "playwright-core": "1.61.0",
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
