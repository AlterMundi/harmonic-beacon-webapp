// Fresh PostgreSQL schema for the August 2026 weekend MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  FACILITATOR
  FACILITATOR_OP
  OPERATOR
  ADMIN
}

enum AnalyticsRole {
  VIEWER
  EXPORTER
}

enum SessionLanguage {
  ENGLISH
  SPANISH
}

enum ScheduledSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum TicketTier {
  GLOBAL_NORTH
  GLOBAL_SOUTH
  COMP
  SUPPORT_OVERRIDE
}

enum TicketEntitlementState {
  ISSUED
  BOUND
  REVOKED
  EXPIRED
}

enum PromoInvitationStatus {
  ACTIVE
  DISABLED
}

enum CommerceProvider {
  TICKET_TAILOR
}

enum CommerceProviderState {
  ACTIVE
  REVOKED
}

enum CommerceAdministrativeState {
  CLEAR
  SUSPENDED
}

enum CommerceMediaStatus {
  NOT_REQUIRED
  RECONCILIATION_REQUIRED
  DISCONNECTED
}

enum CommerceOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
}

enum ContributionVisibility {
  NAMED
  ANONYMOUS
}

enum ContributionState {
  VISIBLE
  HIDDEN
  WITHDRAWN
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  role           StaffRole
  passwordDigest String    @map("password_digest")
  disabledAt     DateTime? @map("disabled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  facilitatedSessions  ScheduledSession[]   @relation("SessionFacilitator")
  issuedTickets        TicketEntitlement[]  @relation("TicketIssuer")
  revokedTickets       TicketEntitlement[]  @relation("TicketRevoker")
  issuedPromoInvites   PromoInvitation[]    @relation("PromoInvitationIssuer")
  disabledPromoInvites PromoInvitation[]    @relation("PromoInvitationDisabler")
  webSessions          WebSession[]         @relation("StaffWebSessions")
  revokedWebSessions   WebSession[]         @relation("WebSessionRevoker")
  participations       SessionParticipant[] @relation("StaffParticipation")
  grantedParticipants  SessionParticipant[] @relation("StageGrantActor")
  auditEntries         AuditLog[]           @relation("AuditActor")
  accountBinding       StaffAccountBinding?
  analyticsGrant       AnalyticsRoleGrant?

  @@map("users")
}

model AnalyticsRoleGrant {
  id          String        @id @default(uuid()) @db.Uuid
  staffUserId String        @unique @map("staff_user_id") @db.Uuid
  staffUser   User          @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role        AnalyticsRole
  grantedAt   DateTime      @default(now()) @map("granted_at")
  revokedAt   DateTime?     @map("revoked_at")
  grantedBy   String        @map("granted_by") @db.VarChar(64)

  @@index([role, revokedAt])
  @@map("analytics_role_grants")
}

model ScheduledSession {
  id            String                 @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  roomName      String                 @unique @map("room_name")
  language      SessionLanguage
  scheduledAt   DateTime               @map("scheduled_at")
  startedAt     DateTime?              @map("started_at")
  endedAt       DateTime?              @map("ended_at")
  status        ScheduledSessionStatus @default(SCHEDULED)
  isTest        Boolean                @default(false) @map("is_test")
  paidMode      Boolean                @default(true) @map("paid_mode")
  publicAccess  Boolean                @default(false) @map("public_access")
  attendeeCap   Int                    @default(150) @map("attendee_cap")
  maxPublishers Int                    @default(6) @map("max_publishers")
  facilitatorId String                 @map("facilitator_id") @db.Uuid
  facilitator   User                   @relation("SessionFacilitator", fields: [facilitatorId], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tickets              TicketEntitlement[]
  participants         SessionParticipant[]
  commerceEntitlements CommerceEntitlement[]
  promoInvitations     PromoInvitation[]
  contributions        SessionContribution[]
  presenceIntervals    LivePresenceInterval[]

  @@index([status, scheduledAt])
  @@map("scheduled_sessions")
}

model TicketEntitlement {
  id                 String                 @id @default(uuid()) @db.Uuid
  scheduledSessionId String                 @map("scheduled_session_id") @db.Uuid
  scheduledSession   ScheduledSession       @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  codeDigest         String                 @unique @map("code_digest")
  codeLastFour       String                 @map("code_last_four") @db.VarChar(4)
  tier               TicketTier
  state              TicketEntitlementState @default(ISSUED)
  boundEmail         String?                @map("bound_email")
  // Central Beacon Account subject. This is the authorization binding when
  // BEACON_ACCOUNT_ENABLED=true; boundEmail remains a provider audit snapshot.
  accountId          String?                @map("account_id")
  accountIssuer      String?                @map("account_issuer")
  boundAt            DateTime?              @map("bound_at")
  expiresAt          DateTime               @map("expires_at")
  issuedByUserId     String?                @map("issued_by_user_id") @db.Uuid
  issuedBy           User?                  @relation("TicketIssuer", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  revokedAt          DateTime?              @map("revoked_at")
  revokedByUserId    String?                @map("revoked_by_user_id") @db.Uuid
  revokedBy          User?                  @relation("TicketRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revocationReason   String?                @map("revocation_reason")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  webSessions         WebSession[]
  participations      SessionParticipant[]
  commerceEntitlement CommerceEntitlement?
  promoRedemption     PromoRedemption?

  @@index([scheduledSessionId, state])
  @@index([boundEmail])
  @@index([accountIssuer, accountId])
  @@index([codeLastFour])
  @@map("ticket_entitlements")
}

model PromoInvitation {
  id                 String                @id @default(uuid()) @db.Uuid
  scheduledSessionId String                @map("scheduled_session_id") @db.Uuid
  scheduledSession   ScheduledSession      @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  codeDigest         String                @unique @map("code_digest") @db.Char(64)
  label              String
  status             PromoInvitationStatus @default(ACTIVE)
  expiresAt          DateTime              @map("expires_at")
  maxRedemptions     Int                   @map("max_redemptions")
  redemptionCount    Int                   @default(0) @map("redemption_count")
  issuedByUserId     String                @map("issued_by_user_id") @db.Uuid
  issuedBy           User                  @relation("PromoInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  disabledAt         DateTime?             @map("disabled_at")
  disabledByUserId   String?               @map("disabled_by_user_id") @db.Uuid
  disabledBy         User?                 @relation("PromoInvitationDisabler", fields: [disabledByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  redemptions PromoRedemption[]

  @@index([scheduledSessionId, status, expiresAt])
  @@map("promo_invitations")
}

model PromoRedemption {
  id                  String            @id @default(uuid()) @db.Uuid
  promoInvitationId   String            @map("promo_invitation_id") @db.Uuid
  promoInvitation     PromoInvitation   @relation(fields: [promoInvitationId], references: [id], onDelete: Cascade)
  redeemerDigest      String            @map("redeemer_digest") @db.Char(64)
  ticketEntitlementId String            @unique @map("ticket_entitlement_id") @db.Uuid
  ticketEntitlement   TicketEntitlement @relation(fields: [ticketEntitlementId], references: [id], onDelete: Cascade)
  redeemedAt          DateTime          @default(now()) @map("redeemed_at")

  @@unique([promoInvitationId, redeemerDigest])
  @@map("promo_redemptions")
}

model CommerceEntitlement {
  id                          String                      @id @default(uuid()) @db.Uuid
  provider                    CommerceProvider
  externalTicketId            String                      @map("external_ticket_id")
  externalOrderId             String                      @map("external_order_id")
  registrationId              String                      @map("registration_id") @db.Uuid
  scheduledSessionId          String                      @map("scheduled_session_id") @db.Uuid
  scheduledSession            ScheduledSession            @relation(fields: [scheduledSessionId], references: [id], onDelete: Restrict)
  ticketEntitlementId         String                      @unique @map("ticket_entitlement_id") @db.Uuid
  ticketEntitlement           TicketEntitlement           @relation(fields: [ticketEntitlementId], references: [id], onDelete: Restrict)
  providerState               CommerceProviderState       @map("provider_state")
  administrativeState         CommerceAdministrativeState @default(CLEAR) @map("administrative_state")
  reasonCode                  String                      @map("reason_code")
  provisionRevision           Int                         @map("provision_revision")
  commandHash                 String                      @map("command_hash") @db.Char(64)
  boundEmail                  String                      @map("bound_email")
  tier                        TicketTier
  bindingGrantId              String?                     @map("binding_grant_id") @db.Uuid
  highestGrantGeneration      Int?                        @map("highest_grant_generation")
  bindingDerivationKeyVersion Int?                        @map("binding_derivation_key_version")
  bindingCodeDigest           String?                     @map("binding_code_digest") @db.Char(64)
  grantId                     String?                     @map("grant_id") @db.Uuid
  grantGeneration             Int?                        @map("grant_generation")
  derivationKeyVersion        Int?                        @map("derivation_key_version")
  codeDigestVersion           Int?                        @map("code_digest_version")
  providerObservedAt          DateTime                    @map("provider_observed_at")
  mediaStatus                 CommerceMediaStatus         @default(NOT_REQUIRED) @map("media_status")
  livekitIdentityVersion      Int                         @default(1) @map("livekit_identity_version")
  maxLivekitTokenExpiresAt    DateTime?                   @map("max_livekit_token_expires_at")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")

  commands  CommerceEntitlementCommand[]
  receipts  CommerceRequestReceipt[]
  mediaJobs CommerceMediaOutbox[]

  @@unique([provider, externalTicketId])
  @@index([scheduledSessionId, providerState, administrativeState])
  @@index([grantId, grantGeneration])
  @@map("commerce_entitlements")
}

model CommerceRequestReceipt {
  id                    String              @id @default(uuid()) @db.Uuid
  commerceEntitlementId String              @map("commerce_entitlement_id") @db.Uuid
  commerceEntitlement   CommerceEntitlement @relation(fields: [commerceEntitlementId], references: [id], onDelete: Cascade)
  source                String
  requestId             String              @map("request_id") @db.Uuid
  provisionRevision     Int                 @map("provision_revision")
  commandHash           String              @map("command_hash") @db.Char(64)
  createdAt             DateTime            @default(now()) @map("created_at")

  @@unique([source, requestId])
  @@index([commerceEntitlementId, provisionRevision])
  @@map("commerce_request_receipts")
}

model CommerceEntitlementCommand {
  id                    String              @id @default(uuid()) @db.Uuid
  commerceEntitlementId String              @map("commerce_entitlement_id") @db.Uuid
  commerceEntitlement   CommerceEntitlement @relation(fields: [commerceEntitlementId], references: [id], onDelete: Cascade)
  source                String
  requestId             String              @map("request_id") @db.Uuid
  provisionRevision     Int                 @map("provision_revision")
  commandHash           String              @map("command_hash") @db.Char(64)
  appliedSnapshot       Json                @map("applied_snapshot")
  webSessionsRevoked    Int                 @default(0) @map("web_sessions_revoked")
  createdAt             DateTime            @default(now()) @map("created_at")

  @@unique([source, requestId])
  @@unique([commerceEntitlementId, provisionRevision])
  @@map("commerce_entitlement_commands")
}

model CommerceMediaOutbox {
  id                    String               @id @default(uuid()) @db.Uuid
  commerceEntitlementId String               @map("commerce_entitlement_id") @db.Uuid
  commerceEntitlement   CommerceEntitlement  @relation(fields: [commerceEntitlementId], references: [id], onDelete: Cascade)
  provisionRevision     Int                  @map("provision_revision")
  stageRoomName         String               @map("stage_room_name")
  participantIdentity   String               @map("participant_identity")
  bedIdentity           String               @map("bed_identity")
  tokenHorizonAt        DateTime             @map("token_horizon_at")
  status                CommerceOutboxStatus @default(PENDING)
  attempts              Int                  @default(0)
  stageRemoved          Int                  @default(0) @map("stage_removed")
  bedRemoved            Int                  @default(0) @map("bed_removed")
  nextAttemptAt         DateTime             @default(now()) @map("next_attempt_at")
  lastAttemptAt         DateTime?            @map("last_attempt_at")
  lastErrorCode         String?              @map("last_error_code")
  completedAt           DateTime?            @map("completed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@unique([commerceEntitlementId, provisionRevision])
  @@index([status, nextAttemptAt])
  @@map("commerce_media_outbox")
}

model WebSession {
  id                     String             @id @default(uuid()) @db.Uuid
  tokenDigest            String             @unique @map("token_digest")
  displayName            String?            @map("display_name")
  displayNameConfirmedAt DateTime?          @map("display_name_confirmed_at")
  accountIssuer          String?            @map("account_issuer")
  accountSubject         String?            @map("account_subject")
  accountSessionId       String?            @map("account_session_id")
  accountDisplayName     String?            @map("account_display_name")
  accountValidatedAt     DateTime?          @map("account_validated_at")
  staffUserId            String?            @map("staff_user_id") @db.Uuid
  staffUser              User?              @relation("StaffWebSessions", fields: [staffUserId], references: [id], onDelete: Cascade)
  ticketEntitlementId    String?            @map("ticket_entitlement_id") @db.Uuid
  ticketEntitlement      TicketEntitlement? @relation(fields: [ticketEntitlementId], references: [id], onDelete: Cascade)
  expiresAt              DateTime           @map("expires_at")
  lastSeenAt             DateTime?          @map("last_seen_at")
  revokedAt              DateTime?          @map("revoked_at")
  revokedByUserId        String?            @map("revoked_by_user_id") @db.Uuid
  revokedBy              User?              @relation("WebSessionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revocationReason       String?            @map("revocation_reason")
  createdAt              DateTime           @default(now()) @map("created_at")

  @@index([staffUserId])
  @@index([ticketEntitlementId])
  @@index([expiresAt])
  @@index([accountIssuer, accountSubject])
  @@index([accountIssuer, accountSessionId])
  @@map("web_sessions")
}

/// Explicit, operator-provisioned bridge from a central Beacon Account to an
/// existing local staff authority. Email is deliberately absent: roles remain
/// local and changing an Account email cannot create or transfer staff access.
model StaffAccountBinding {
  id             String    @id @default(uuid()) @db.Uuid
  accountIssuer  String    @map("account_issuer")
  accountSubject String    @map("account_subject")
  staffUserId    String    @unique @map("staff_user_id") @db.Uuid
  staffUser      User      @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  disabledAt     DateTime? @map("disabled_at")

  @@unique([accountIssuer, accountSubject])
  @@map("staff_account_bindings")
}

/// One-use OAuth authorization transaction. Only opaque protocol material is
/// persisted; provider tokens and profile/email claims never enter this table.
model AccountLoginAttempt {
  stateDigest            String    @id @map("state_digest") @db.Char(64)
  codeVerifier           String    @map("code_verifier")
  nonce                  String
  flow                   String    @db.VarChar(16)
  returnTo               String    @map("return_to")
  pendingPromoDigest     String?   @map("pending_promo_digest") @db.Char(64)
  pendingDisplayName     String?   @map("pending_display_name")
  pendingTermsVersion    String?   @map("pending_terms_version")
  pendingTermsAcceptedAt DateTime? @map("pending_terms_accepted_at")
  expiresAt              DateTime  @map("expires_at")
  consumedAt             DateTime? @map("consumed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("account_login_attempts")
}

model SessionParticipant {
  id                   String             @id @default(uuid()) @db.Uuid
  scheduledSessionId   String             @map("scheduled_session_id") @db.Uuid
  scheduledSession     ScheduledSession   @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  participantIdentity  String             @map("participant_identity")
  // Event alias captured when this participation is first materialized.
  displayName          String?            @map("display_name")
  ticketEntitlementId  String?            @map("ticket_entitlement_id") @db.Uuid
  ticketEntitlement    TicketEntitlement? @relation(fields: [ticketEntitlementId], references: [id], onDelete: Cascade)
  staffUserId          String?            @map("staff_user_id") @db.Uuid
  staffUser            User?              @relation("StaffParticipation", fields: [staffUserId], references: [id], onDelete: Cascade)
  joinedAt             DateTime           @default(now()) @map("joined_at")
  leftAt               DateTime?          @map("left_at")
  raisedAt             DateTime?          @map("raised_at")
  publishGrantedAt     DateTime?          @map("publish_granted_at")
  publishRevokedAt     DateTime?          @map("publish_revoked_at")
  grantVersion         Int                @default(0) @map("grant_version")
  grantReconcileNeeded Boolean            @default(false) @map("grant_reconcile_needed")
  grantChangedByUserId String?            @map("grant_changed_by_user_id") @db.Uuid
  grantChangedBy       User?              @relation("StageGrantActor", fields: [grantChangedByUserId], references: [id], onDelete: SetNull)
  grantReason          String?            @map("grant_reason")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  contributions     SessionContribution[]
  presenceIntervals LivePresenceInterval[]

  @@unique([scheduledSessionId, participantIdentity])
  @@index([scheduledSessionId, raisedAt])
  @@index([scheduledSessionId, publishGrantedAt])
  @@map("session_participants")
}

// Server-observed event presence. The browser can heartbeat an authenticated
// principal but cannot submit timestamps or elapsed duration.
model LivePresenceInterval {
  id                 String             @id @default(uuid()) @db.Uuid
  scheduledSessionId String             @map("scheduled_session_id") @db.Uuid
  scheduledSession   ScheduledSession   @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  participantId      String             @map("participant_id") @db.Uuid
  participant        SessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  generation         Int
  startedAt          DateTime           @map("started_at")
  lastHeartbeatAt    DateTime           @map("last_heartbeat_at")
  endedAt            DateTime?          @map("ended_at")
  endReason          String?            @map("end_reason") @db.VarChar(32)
  reconnectCount     Int                @default(0) @map("reconnect_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([participantId, generation])
  @@index([scheduledSessionId, startedAt, endedAt])
  @@index([endedAt, lastHeartbeatAt])
  @@map("live_presence_intervals")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole   StaffRole? @map("actor_role")
  action      String
  targetType  String     @map("target_type")
  targetId    String     @map("target_id")
  reason      String?
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// CHAT-01 (#137): a session-scoped question + emotion published by one
// attendee. The author link is internal correlation for the future personal
// follow-up; `Restrict` keeps a participant with contributions from being
// deleted underneath them (retention/withdrawal transitions are CHAT-02's).
// HIDDEN and WITHDRAWN exist from this migration so moderation never needs a
// destructive second one, but no transition endpoints ship in #137.
model SessionContribution {
  id                  String                 @id @default(uuid()) @db.Uuid
  scheduledSessionId  String                 @map("scheduled_session_id") @db.Uuid
  scheduledSession    ScheduledSession       @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  authorParticipantId String                 @map("author_participant_id") @db.Uuid
  authorParticipant   SessionParticipant     @relation(fields: [authorParticipantId], references: [id], onDelete: Restrict)
  authorDisplayName   String                 @map("author_display_name")
  body                String
  visibility          ContributionVisibility
  state               ContributionState      @default(VISIBLE)
  idempotencyKey      String                 @map("idempotency_key")
  requestDigest       String                 @map("request_digest") @db.Char(64)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@unique([scheduledSessionId, authorParticipantId, idempotencyKey])
  @@index([scheduledSessionId, state, createdAt, id])
  @@map("session_contributions")
}
