{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmonicbeacon.com/contracts/early-bird-authority/v1/checkout-create.schema.json",
  "title": "EarlyBird internal checkout create request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "account_id", "provider", "return_url", "cancel_url"],
  "properties": {
    "schema_version": {"const": "early-bird-authority.checkout-create.v1"},
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$"
    },
    "provider": {"enum": ["paypal", "mercado_pago"]},
    "return_url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"},
    "cancel_url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"}
  }
}
