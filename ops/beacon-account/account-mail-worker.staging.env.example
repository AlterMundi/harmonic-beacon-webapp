# Copy to /etc/harmonic-beacon/account-mail-worker.staging.env as root:root 0600.
# This file deliberately excludes browser auth, OAuth provider and RP secrets.
DATABASE_URL=postgresql://beacon_account_staging:replace-staging-database-password-32-random@account-staging-postgres:5432/beacon_account_staging?schema=public
BEACON_ACCOUNT_BASE_URL=https://account-staging.harmonicbeacon.com
BEACON_ACCOUNT_MAIL_DELIVERY_TOKEN=replace-staging-private-mail-token-32-random
BEACON_ACCOUNT_MAIL_OUTBOX_KEY=replaceStagingOutboxKeyAAAAAAAAAAAAAAAAAAAA
