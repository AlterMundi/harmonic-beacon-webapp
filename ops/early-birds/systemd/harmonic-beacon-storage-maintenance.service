[Unit]
Description=Bounded Harmonic Beacon cache and historical image retention
After=docker.service
RequiresMountsFor=/mnt/beacon-data

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/libexec/harmonic-beacon/storage-maintenance.py --apply
TimeoutStartSec=30min
UMask=0077
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/harmonic-beacon /mnt/beacon-data/archives/runtime-images /run/lock
